<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:PresentationApp.Core.Models;assembly=PresentationApp.Core"
                    xmlns:conv="clr-namespace:PresentationApp.UI.Converters">

    <!-- Dessin des éléments dans les miniatures du panneau de gauche.
         Chaque type d'élément (texte, forme, image) a son propre modèle :
         WPF choisit automatiquement le bon grâce à DataType. -->

    <conv:ShapeGeometryConverter x:Key="FormeVersGeometrie"/>
    <conv:ImagePathConverter x:Key="CheminVersImage"/>
    <conv:SlideNumberConverter x:Key="NumeroDiapositive"/>

    <!-- TEXTE -->
    <DataTemplate DataType="{x:Type models:TextElement}">
        <TextBlock Text="{Binding Text}"
                   Width="{Binding Width}"
                   Height="{Binding Height}"
                   FontFamily="{Binding Style.FontFamily}"
                   FontSize="{Binding Style.FontSize}"
                   Foreground="{Binding Style.TextColor, FallbackValue=Black}"
                   TextAlignment="{Binding Style.TextAlignment, FallbackValue=Left}"
                   TextWrapping="Wrap"
                   ClipToBounds="True"
                   RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
                <RotateTransform Angle="{Binding Rotation}"/>
            </TextBlock.RenderTransform>
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Style.IsBold}" Value="True">
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Style.IsItalic}" Value="True">
                            <Setter Property="FontStyle" Value="Italic"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Style.IsUnderline}" Value="True">
                            <Setter Property="TextDecorations" Value="Underline"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>

    <!-- FORMES : les 20 types sont dessinés grâce au convertisseur FormeVersGeometrie -->
    <DataTemplate DataType="{x:Type models:ShapeElement}">
        <Path Width="{Binding Width}"
              Height="{Binding Height}"
              Data="{Binding ShapeType, Converter={StaticResource FormeVersGeometrie}}"
              Fill="{Binding Style.FillColor, FallbackValue=LightBlue}"
              Stroke="{Binding Style.StrokeColor, FallbackValue=Black}"
              StrokeThickness="{Binding Style.StrokeThickness}"
              Stretch="Fill"
              RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <RotateTransform Angle="{Binding Rotation}"/>
            </Path.RenderTransform>
        </Path>
    </DataTemplate>

    <!-- IMAGE : la vraie image si elle existe, sinon un cadre gris -->
    <DataTemplate DataType="{x:Type models:ImageElement}">
        <Grid Width="{Binding Width}"
              Height="{Binding Height}"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <RotateTransform Angle="{Binding Rotation}"/>
            </Grid.RenderTransform>

            <Border Background="#E5E5E5" BorderBrush="#999999" BorderThickness="1">
                <TextBlock Text="Image" FontSize="28" Foreground="#777777"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Image Source="{Binding ImagePath, Converter={StaticResource CheminVersImage}}"
                   Stretch="Fill"/>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
