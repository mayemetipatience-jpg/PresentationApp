<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Styles partagés par le ruban (ToolbarView), les miniatures et le panneau de propriétés.
         Palette « océan » de l'équipe : bleu canard foncé + turquoise. -->

    <SolidColorBrush x:Key="CouleurPrincipale" Color="#123B46"/>
    <SolidColorBrush x:Key="CouleurAccent" Color="#20B5A5"/>
    <SolidColorBrush x:Key="CouleurAccentClair" Color="#E5F4F1"/>
    <SolidColorBrush x:Key="CouleurFond" Color="#F3F5F2"/>
    <SolidColorBrush x:Key="CouleurBordure" Color="#DCE4E2"/>
    <SolidColorBrush x:Key="CouleurTexteSecondaire" Color="#668087"/>

    <!-- Bouton standard -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#123B46"/>
        <Setter Property="BorderBrush" Value="{StaticResource CouleurBordure}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E5F4F1"/>
                <Setter Property="BorderBrush" Value="#20B5A5"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bouton mis en avant (turquoise) -->
    <Style x:Key="BoutonPrincipal" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#20B5A5"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Bouton à bascule (gras, italique, souligné) -->
    <Style TargetType="ToggleButton">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource CouleurBordure}"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Onglets du ruban -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="#45636A"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#123B46"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Petit bouton carré (alignement du texte) -->
    <Style x:Key="BoutonIcone" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <!-- Titre gris sous chaque groupe du ruban -->
    <Style x:Key="TitreGroupe" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource CouleurTexteSecondaire}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="2,4,2,0"/>
    </Style>

    <!-- Trait vertical entre deux groupes du ruban -->
    <Style x:Key="SeparateurGroupe" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="#E0E0E0"/>
        <Setter Property="Margin" Value="8,4"/>
    </Style>

    <!-- Titre d'une section du panneau de propriétés -->
    <Style x:Key="TitreSection" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,12,0,4"/>
    </Style>

    <!-- Petite étiquette au-dessus d'un champ -->
    <Style x:Key="Etiquette" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#555555"/>
        <Setter Property="Margin" Value="2,4,2,2"/>
    </Style>

    <!-- Liste de couleurs avec un carré de couleur devant le nom -->
    <DataTemplate x:Key="ModeleCouleur">
        <StackPanel Orientation="Horizontal">
            <Border Width="14" Height="14" Margin="0,0,6,0"
                    Background="{Binding Hex}"
                    BorderBrush="#999999" BorderThickness="1"/>
            <TextBlock Text="{Binding Nom}" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
