<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Styles partagés par le ruban (ToolbarView) et le panneau de propriétés -->

    <SolidColorBrush x:Key="CouleurAccent" Color="#B7472A"/>
    <SolidColorBrush x:Key="CouleurBordure" Color="#D5D5D5"/>
    <SolidColorBrush x:Key="CouleurTexteSecondaire" Color="#777777"/>

    <!-- Bouton standard -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="BorderBrush" Value="{StaticResource CouleurBordure}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#AAAAAA"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bouton à bascule (gras, italique, souligné) -->
    <Style TargetType="ToggleButton">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource CouleurBordure}"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Petit bouton carré (alignement du texte) -->
    <Style x:Key="BoutonIcone" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <!-- Titre gris sous chaque groupe du ruban -->
    <Style x:Key="TitreGroupe" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource CouleurTexteSecondaire}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="2,4,2,0"/>
    </Style>

    <!-- Trait vertical entre deux groupes du ruban -->
    <Style x:Key="SeparateurGroupe" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="#E0E0E0"/>
        <Setter Property="Margin" Value="8,4"/>
    </Style>

    <!-- Titre d'une section du panneau de propriétés -->
    <Style x:Key="TitreSection" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,12,0,4"/>
    </Style>

    <!-- Petite étiquette au-dessus d'un champ -->
    <Style x:Key="Etiquette" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#555555"/>
        <Setter Property="Margin" Value="2,4,2,2"/>
    </Style>

    <!-- Liste de couleurs avec un carré de couleur devant le nom -->
    <DataTemplate x:Key="ModeleCouleur">
        <StackPanel Orientation="Horizontal">
            <Border Width="14" Height="14" Margin="0,0,6,0"
                    Background="{Binding Hex}"
                    BorderBrush="#999999" BorderThickness="1"/>
            <TextBlock Text="{Binding Nom}" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
