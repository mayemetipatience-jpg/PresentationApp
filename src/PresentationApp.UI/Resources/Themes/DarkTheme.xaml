<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Thème sombre : mêmes noms de clés que le thème clair -->
    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ThemeTextBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#4CC2FF" />
    <FontFamily x:Key="ThemeFontFamily">Segoe UI</FontFamily>

</ResourceDictionary>