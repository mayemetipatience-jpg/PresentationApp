<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Thème océan : mêmes noms de clés que les autres thèmes -->
    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#E8F4F8" />
    <SolidColorBrush x:Key="ThemeTextBrush" Color="#0B3C5D" />
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#1F8A9E" />
    <FontFamily x:Key="ThemeFontFamily">Segoe UI</FontFamily>

</ResourceDictionary>