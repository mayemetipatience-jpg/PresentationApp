<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Thème clair : les mêmes noms de clés sont utilisés dans chaque thème -->
    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeTextBrush" Color="#222222" />
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#2B579A" />
    <FontFamily x:Key="ThemeFontFamily">Segoe UI</FontFamily>

</ResourceDictionary>