<Window x:Class="PresentationApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:canvas="clr-namespace:PresentationApp.UI.Canvas"
        Title="Mini PowerPoint"
        Height="800"
        Width="1300"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#D5D5D5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,5,2,0"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="38"/>
            <RowDefinition Height="112"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- BARRE SUPERIEURE -->
        <Border Grid.Row="0" Background="#B7472A">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="P"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="5,0,15,0"/>

                <TextBlock Grid.Column="1"
                           Text="Mini PowerPoint  |  Présentation sans titre"
                           Foreground="White"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button Content="Partager"
                            Background="#963820"
                            Foreground="White"
                            BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ONGLETS DU RUBAN -->
        <Border Grid.Row="1" Background="White">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource TabButton}"
                        Content="Fichier"/>
                <Button Style="{StaticResource TabButton}"
                        Content="Accueil"
                        FontWeight="Bold"
                        Foreground="#B7472A"/>
                <Button Style="{StaticResource TabButton}"
                        Content="Insertion"/>
                <Button Style="{StaticResource TabButton}"
                        Content="Création"/>
                <Button Style="{StaticResource TabButton}"
                        Content="Transitions"/>
                <Button Style="{StaticResource TabButton}"
                        Content="Animations"/>
                <Button Style="{StaticResource TabButton}"
                        Content="Diaporama"/>
                <Button Style="{StaticResource TabButton}"
                        Content="Affichage"/>
            </StackPanel>
        </Border>

        <!-- RUBAN D'OUTILS -->
        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,1"
                Padding="8,5">

            <StackPanel Orientation="Horizontal">

                <StackPanel Width="125">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="Coller"
                                FontSize="13"
                                Padding="12,18"/>
                        <StackPanel>
                            <Button Content="Couper"/>
                            <Button Content="Copier"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Presse-papiers"
                               Style="{StaticResource GroupTitle}"/>
                </StackPanel>

                <Separator Margin="8,5"/>

                <StackPanel Width="170">
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="Texte"/>
                        <Button Content="Police"/>
                        <Button Content="Couleur"/>
                        <Button Content="Taille"/>
                    </WrapPanel>
                    <TextBlock Text="Texte"
                               Style="{StaticResource GroupTitle}"/>
                </StackPanel>

                <Separator Margin="8,5"/>

                <StackPanel Width="180">
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="Rectangle"/>
                        <Button Content="Ellipse"/>
                        <Button Content="Ligne"/>
                        <Button Content="Flèche"/>
                    </WrapPanel>
                    <TextBlock Text="Formes"
                               Style="{StaticResource GroupTitle}"/>
                </StackPanel>

                <Separator Margin="8,5"/>

                <StackPanel Width="150">
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="Image"/>
                        <Button Content="Arrière-plan"/>
                        <Button Content="Rotation"/>
                    </WrapPanel>
                    <TextBlock Text="Modification"
                               Style="{StaticResource GroupTitle}"/>
                </StackPanel>

                <Separator Margin="8,5"/>

                <StackPanel Width="145">
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="Ajouter"/>
                        <Button Content="Supprimer"/>
                    </WrapPanel>
                    <TextBlock Text="Diapositives"
                               Style="{StaticResource GroupTitle}"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ZONE DE TRAVAIL -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="235"/>
            </Grid.ColumnDefinitions>

            <!-- PANNEAU GAUCHE -->
            <Border Grid.Column="0"
                    Background="#F8F8F8"
                    BorderBrush="#DDDDDD"
                    BorderThickness="0,0,1,0">

                <DockPanel Margin="10">

                    <TextBlock Text="Diapositives"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="5,5,5,12"
                               DockPanel.Dock="Top"/>

                    <Button Content="+ Nouvelle diapositive"
                            DockPanel.Dock="Bottom"
                            HorizontalAlignment="Stretch"
                            Margin="2,8,2,2"/>

                    <Grid>
                        <ListBox x:Name="lstDiapositives"
                                 Background="Transparent"
                                 BorderThickness="0"/>

                        <TextBlock Text="Les diapositives apparaîtront ici"
                                   Foreground="#999999"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                </DockPanel>
            </Border>

            <!-- CANVAS CENTRAL -->
            <Grid Grid.Column="1"
                  Background="#E8E8E8">

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">

                    <Grid>
                        <Viewbox Stretch="Uniform"
                                 MaxWidth="960"
                                 MaxHeight="540"
                                 Margin="35">

                            <Border Background="White"
                                    Width="960"
                                    Height="540"
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="1">

                                <canvas:SlideCanvas
                                    x:Name="slideCanvas"/>

                            </Border>

                        </Viewbox>
                    </Grid>

                </ScrollViewer>
            </Grid>

            <!-- PANNEAU DROIT -->
            <Border Grid.Column="2"
                    Background="#FAFAFA"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1,0,0,0">

                <StackPanel Margin="12">

                    <TextBlock Text="Format de l'élément"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,5,0,18"/>

                    <TextBlock Text="Position"
                               FontWeight="SemiBold"
                               Margin="0,5"/>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="2">
                            <TextBlock Text="Horizontal"/>
                            <TextBox Text="0"
                                     Padding="5"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="2">
                            <TextBlock Text="Vertical"/>
                            <TextBox Text="0"
                                     Padding="5"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,12"/>

                    <TextBlock Text="Dimensions"
                               FontWeight="SemiBold"
                               Margin="0,5"/>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="2">
                            <TextBlock Text="Largeur"/>
                            <TextBox Text="100"
                                     Padding="5"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="2">
                            <TextBlock Text="Hauteur"/>
                            <TextBox Text="50"
                                     Padding="5"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,12"/>

                    <TextBlock Text="Apparence"
                               FontWeight="SemiBold"
                               Margin="0,5"/>

                    <TextBlock Text="Couleur de remplissage"
                               Margin="2,8,2,3"/>

                    <Button Content="Choisir une couleur"/>

                    <TextBlock Text="Rotation"
                               Margin="2,12,2,3"/>

                    <Slider Minimum="0"
                            Maximum="360"
                            Value="0"/>

                </StackPanel>
            </Border>

        </Grid>

        <!-- BARRE D'ETAT -->
        <Border Grid.Row="4"
                Background="#F8F8F8"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0">

            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Diapositive 0 sur 0"
                           FontSize="11"
                           Foreground="#666666"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Zoom"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                    <Slider Width="100"
                            Minimum="50"
                            Maximum="150"
                            Value="100"
                            Margin="10,0"/>
                    <TextBlock Text="100%"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
