<Window x:Class="PresentationApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:canvas="clr-namespace:PresentationApp.UI.Canvas"
        xmlns:models="clr-namespace:PresentationApp.Core.Models;assembly=PresentationApp.Core"
        Title="Mini PowerPoint"
        Height="800"
        Width="1300"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

	<Window.Resources>

		<Style TargetType="Button">
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="#333333"/>
			<Setter Property="BorderBrush" Value="#D5D5D5"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="12,7"/>
			<Setter Property="Margin" Value="3"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style x:Key="TabButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="15,9"/>
			<Setter Property="Margin" Value="2,0"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>

		<Style x:Key="GroupTitle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="#777777"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="2,5,2,0"/>
		</Style>

		<!-- MINIATURE : TEXTE -->
		<DataTemplate DataType="{x:Type models:TextElement}">
			<TextBlock Text="{Binding Text}"
                       Width="{Binding Width}"
                       Height="{Binding Height}"
                       FontFamily="{Binding Style.FontFamily}"
                       FontSize="{Binding Style.FontSize}"
                       Foreground="{Binding Style.TextColor, FallbackValue=Black}"
                       TextWrapping="Wrap"
                       TextAlignment="{Binding Style.TextAlignment, FallbackValue=Left}"
                       ClipToBounds="True"
                       RenderTransformOrigin="0.5,0.5">

				<TextBlock.RenderTransform>
					<RotateTransform Angle="{Binding Rotation}"/>
				</TextBlock.RenderTransform>

				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Setter Property="FontWeight" Value="Normal"/>
						<Setter Property="FontStyle" Value="Normal"/>
						<Setter Property="TextDecorations" Value="{x:Null}"/>

						<Style.Triggers>
							<DataTrigger Binding="{Binding Style.IsBold}" Value="True">
								<Setter Property="FontWeight" Value="Bold"/>
							</DataTrigger>

							<DataTrigger Binding="{Binding Style.IsItalic}" Value="True">
								<Setter Property="FontStyle" Value="Italic"/>
							</DataTrigger>

							<DataTrigger Binding="{Binding Style.IsUnderline}" Value="True">
								<Setter Property="TextDecorations" Value="Underline"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
		</DataTemplate>

		<!-- MINIATURE : FORMES -->
		<DataTemplate DataType="{x:Type models:ShapeElement}">
			<Grid Width="{Binding Width}"
                  Height="{Binding Height}">

				<Rectangle x:Name="MiniRectangle"
                           Fill="{Binding Style.FillColor}"
                           Stroke="{Binding Style.StrokeColor}"
                           StrokeThickness="{Binding Style.StrokeThickness}"
                           Visibility="Visible"/>

				<Ellipse x:Name="MiniEllipse"
                         Fill="{Binding Style.FillColor}"
                         Stroke="{Binding Style.StrokeColor}"
                         StrokeThickness="{Binding Style.StrokeThickness}"
                         Visibility="Collapsed"/>

				<Line x:Name="MiniLine"
                      X1="0"
                      Y1="0"
                      X2="{Binding Width}"
                      Y2="{Binding Height}"
                      Stroke="{Binding Style.StrokeColor}"
                      StrokeThickness="{Binding Style.StrokeThickness}"
                      Visibility="Collapsed"/>

				<Line x:Name="MiniArrow"
                      X1="0"
                      Y1="0"
                      X2="{Binding Width}"
                      Y2="{Binding Height}"
                      Stroke="{Binding Style.StrokeColor}"
                      StrokeThickness="{Binding Style.StrokeThickness}"
                      Visibility="Collapsed"/>
			</Grid>

			<DataTemplate.Triggers>

				<DataTrigger Binding="{Binding ShapeType}"
                             Value="{x:Static models:ShapeType.Ellipse}">
					<Setter TargetName="MiniRectangle"
                            Property="Visibility"
                            Value="Collapsed"/>
					<Setter TargetName="MiniEllipse"
                            Property="Visibility"
                            Value="Visible"/>
				</DataTrigger>

				<DataTrigger Binding="{Binding ShapeType}"
                             Value="{x:Static models:ShapeType.Line}">
					<Setter TargetName="MiniRectangle"
                            Property="Visibility"
                            Value="Collapsed"/>
					<Setter TargetName="MiniLine"
                            Property="Visibility"
                            Value="Visible"/>
				</DataTrigger>

				<DataTrigger Binding="{Binding ShapeType}"
                             Value="{x:Static models:ShapeType.Arrow}">
					<Setter TargetName="MiniRectangle"
                            Property="Visibility"
                            Value="Collapsed"/>
					<Setter TargetName="MiniArrow"
                            Property="Visibility"
                            Value="Visible"/>
				</DataTrigger>

			</DataTemplate.Triggers>
		</DataTemplate>

		<!-- MINIATURE : IMAGE -->
		<DataTemplate DataType="{x:Type models:ImageElement}">
			<Border Width="{Binding Width}"
                    Height="{Binding Height}"
                    Background="#E5E5E5"
                    BorderBrush="#999999"
                    BorderThickness="1"
                    RenderTransformOrigin="0.5,0.5">

				<Border.RenderTransform>
					<RotateTransform Angle="{Binding Rotation}"/>
				</Border.RenderTransform>

				<TextBlock Text="Image"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#555555"/>
			</Border>
		</DataTemplate>

	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="42"/>
			<RowDefinition Height="38"/>
			<RowDefinition Height="190"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="28"/>
		</Grid.RowDefinitions>

		<!-- BARRE SUPERIEURE -->
		<Border Grid.Row="0" Background="#B7472A">
			<Grid Margin="12,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<TextBlock Text="P"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="5,0,15,0"/>

				<TextBlock Grid.Column="1"
                           Text="Mini PowerPoint | Présentation sans titre"
                           Foreground="White"
                           FontSize="14"
                           VerticalAlignment="Center"/>

				<StackPanel Grid.Column="2"
                            Orientation="Horizontal">
					<Button Content="Partager"
                            Background="#963820"
                            Foreground="White"
                            BorderThickness="0"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ONGLETS -->
		<Border Grid.Row="1" Background="White">
			<ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
				<StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

					<Button Style="{StaticResource TabButton}"
                            Content="Fichier"
                            Click="BoutonFichier_Click"/>

					<Button Style="{StaticResource TabButton}"
                            Content="Accueil"
                            FontWeight="Bold"
                            Foreground="#B7472A"/>

					<Button Style="{StaticResource TabButton}"
                            Content="Insertion"/>

					<Button Style="{StaticResource TabButton}"
                            Content="Création"/>

					<Button Style="{StaticResource TabButton}"
                            Content="Transitions"/>

					<Button Style="{StaticResource TabButton}"
                            Content="Animations"/>

					<Button Style="{StaticResource TabButton}"
                            Content="Diaporama"/>

					<Button Style="{StaticResource TabButton}"
                            Content="Affichage"/>

				</StackPanel>
			</ScrollViewer>
		</Border>

		<!-- RUBAN -->
		<Border Grid.Row="2"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,1"
                Padding="8,5">

			<ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">

				<StackPanel Orientation="Horizontal">

					<!-- PRESSE-PAPIERS -->
					<StackPanel Width="125">
						<StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

							<Button Content="Coller"
                                    FontSize="13"
                                    Padding="12,18"
                                    Click="BtnColler_Click"/>

							<StackPanel>
								<Button Content="Couper"
                                        Click="BtnCouper_Click"/>
								<Button Content="Copier"
                                        Click="BtnCopier_Click"/>
							</StackPanel>
						</StackPanel>

						<TextBlock Text="Presse-papiers"
                                   Style="{StaticResource GroupTitle}"/>
					</StackPanel>

					<Separator Margin="8,5"/>

					<!-- FORMATAGE DU TEXTE -->
					<StackPanel Width="450">

						<StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,2,0,5">

							<ComboBox x:Name="cmbPolice"
                                      Width="145"
                                      Height="30"
                                      Margin="3"
                                      SelectedIndex="0"
                                      SelectionChanged="CmbPolice_SelectionChanged"
                                      ToolTip="Choisir la police">

								<ComboBoxItem Content="Segoe UI"/>
								<ComboBoxItem Content="Arial"/>
								<ComboBoxItem Content="Calibri"/>
								<ComboBoxItem Content="Times New Roman"/>
								<ComboBoxItem Content="Verdana"/>
								<ComboBoxItem Content="Georgia"/>
								<ComboBoxItem Content="Comic Sans MS"/>
							</ComboBox>

							<ComboBox x:Name="cmbTaille"
                                      Width="65"
                                      Height="30"
                                      Margin="3"
                                      SelectedIndex="3"
                                      SelectionChanged="CmbTaille_SelectionChanged"
                                      ToolTip="Taille du texte">

								<ComboBoxItem Content="8"/>
								<ComboBoxItem Content="10"/>
								<ComboBoxItem Content="12"/>
								<ComboBoxItem Content="18"/>
								<ComboBoxItem Content="20"/>
								<ComboBoxItem Content="24"/>
								<ComboBoxItem Content="28"/>
								<ComboBoxItem Content="32"/>
								<ComboBoxItem Content="36"/>
								<ComboBoxItem Content="48"/>
								<ComboBoxItem Content="60"/>
								<ComboBoxItem Content="72"/>
							</ComboBox>

							<ComboBox x:Name="cmbCouleurTexte"
                                      Width="125"
                                      Height="30"
                                      Margin="3"
                                      SelectedIndex="0"
                                      SelectionChanged="CmbCouleurTexte_SelectionChanged"
                                      ToolTip="Couleur du texte">

								<ComboBoxItem Content="Noir" Tag="#000000"/>
								<ComboBoxItem Content="Blanc" Tag="#FFFFFF"/>
								<ComboBoxItem Content="Rouge" Tag="#FF0000"/>
								<ComboBoxItem Content="Vert" Tag="#00FF00"/>
								<ComboBoxItem Content="Bleu" Tag="#0000FF"/>
								<ComboBoxItem Content="Jaune" Tag="#FFFF00"/>
								<ComboBoxItem Content="Orange" Tag="#FFA500"/>
								<ComboBoxItem Content="Violet" Tag="#800080"/>
								<ComboBoxItem Content="Bleu clair" Tag="#ADD8E6"/>
								<ComboBoxItem Content="Rose" Tag="#FFC0CB"/>
								<ComboBoxItem Content="Marron" Tag="#A52A2A"/>
								<ComboBoxItem Content="Gris" Tag="#808080"/>
								<ComboBoxItem Content="Turquoise" Tag="#008080"/>
								<ComboBoxItem Content="Or" Tag="#FFD700"/>
								<ComboBoxItem Content="Vert clair" Tag="#90EE90"/>
								<ComboBoxItem Content="Rose vif" Tag="#FF69B4"/>

							</ComboBox>

						</StackPanel>

						<StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

							<Button Content="G"
                                    FontWeight="Bold"
                                    Width="35"
                                    Click="BtnGras_Click"
                                    ToolTip="Mettre en gras"/>

							<Button Content="I"
                                    FontStyle="Italic"
                                    Width="35"
                                    Click="BtnItalique_Click"
                                    ToolTip="Mettre en italique"/>

							<Button Width="35"
                                    Click="BtnSouligne_Click"
                                    ToolTip="Souligner">
								<TextBlock Text="S"
                                           TextDecorations="Underline"/>
							</Button>

							<Separator Margin="4,2"/>

							<Button Content="≡"
                                    FontSize="18"
                                    Width="35"
                                    Click="BtnAlignerGauche_Click"
                                    ToolTip="Aligner à gauche"/>

							<Button Content="☰"
                                    FontSize="18"
                                    Width="35"
                                    Click="BtnCentrerTexte_Click"
                                    ToolTip="Centrer le texte"/>

							<Button Content="≡"
                                    FontSize="18"
                                    Width="35"
                                    Click="BtnAlignerDroite_Click"
                                    ToolTip="Aligner à droite"/>

							<Button Content="Zone de texte"
                                    Click="BtnTexte_Click"/>
						</StackPanel>

						<TextBlock Text="Mise en forme du texte"
                                   Style="{StaticResource GroupTitle}"/>
					</StackPanel>

					<Separator Margin="8,5"/>

					<!-- FORMES -->
					<StackPanel Width="220">

						<ComboBox x:Name="cmbFormes"
                                  Width="200"
                                  Height="38"
                                  Margin="5"
                                  Padding="5"
                                  IsEditable="False"
                                  SelectedIndex="-1"
                                  SelectionChanged="CmbFormes_SelectionChanged"
                                  ToolTip="Choisir une forme">

							<ComboBoxItem Content="Rectangle" Tag="Rectangle"/>
							<ComboBoxItem Content="Rectangle arrondi" Tag="RoundedRectangle"/>
							<ComboBoxItem Content="Ellipse" Tag="Ellipse"/>
							<ComboBoxItem Content="Losange" Tag="Diamond"/>
							<ComboBoxItem Content="Triangle" Tag="Triangle"/>
							<ComboBoxItem Content="Triangle inversé" Tag="InvertedTriangle"/>
							<ComboBoxItem Content="Pentagone" Tag="Pentagon"/>
							<ComboBoxItem Content="Hexagone" Tag="Hexagon"/>
							<ComboBoxItem Content="Carré" Tag="Square"/>
							<ComboBoxItem Content="Demi-cercle" Tag="SemiCircle"/>
							<ComboBoxItem Content="Croix" Tag="Cross"/>
							<ComboBoxItem Content="Plus" Tag="Plus"/>
							<ComboBoxItem Content="Étoile à 5 branches" Tag="Star5"/>
							<ComboBoxItem Content="Étoile à 6 branches" Tag="Star6"/>
							<ComboBoxItem Content="Flèche droite" Tag="Arrow"/>
							<ComboBoxItem Content="Flèche gauche" Tag="ArrowLeft"/>
							<ComboBoxItem Content="Flèche vers le haut" Tag="ArrowUp"/>
							<ComboBoxItem Content="Flèche vers le bas" Tag="ArrowDown"/>
							<ComboBoxItem Content="Flèche double" Tag="DoubleArrow"/>
							<ComboBoxItem Content="Ligne diagonale" Tag="Line"/>

						</ComboBox>

						<TextBlock Text="Formes (20)"
                                   Style="{StaticResource GroupTitle}"/>
					</StackPanel>

					<Separator Margin="8,5"/>

					<!-- MODIFICATION ET CALQUES -->
					<StackPanel Width="215">

						<WrapPanel HorizontalAlignment="Center">

							<Button Content="Image"
                                    Click="BtnImage_Click"/>

							<Button Content="Arrière-plan"
                                    Click="BtnArrierePlan_Click"/>

							<Button Content="Rotation"
                                    Click="BtnRotation_Click"/>

							<Button Content="Supprimer élément"
                                    Click="BtnSupprimerElement_Click"/>

							<Button Content="🔒 Verrouiller / Déverrouiller"
                                    Click="BtnVerrouiller_Click"
                                    ToolTip="Empêcher ou autoriser la modification de l'élément sélectionné"
                                    FontSize="11"
                                    Padding="5,5"/>

						</WrapPanel>

						<Separator Margin="5,3"/>

						<TextBlock Text="Ordre des calques"
                                   Style="{StaticResource GroupTitle}"/>

						<WrapPanel HorizontalAlignment="Center">

							<Button Content="Premier plan"
                                    FontSize="11"
                                    Padding="5,5"
                                    Click="BtnPremierPlan_Click"/>

							<Button Content="Arrière-plan"
                                    FontSize="11"
                                    Padding="5,5"
                                    Click="BtnArrierePlanCalque_Click"/>

							<Button Content="Avancer"
                                    FontSize="11"
                                    Padding="5,5"
                                    Click="BtnAvancerCalque_Click"/>

							<Button Content="Reculer"
                                    FontSize="11"
                                    Padding="5,5"
                                    Click="BtnReculerCalque_Click"/>

						</WrapPanel>

						<TextBlock Text="Modification"
                                   Style="{StaticResource GroupTitle}"/>

					</StackPanel>

					<Separator Margin="8,5"/>

					<!-- DIAPOSITIVES -->
					<StackPanel Width="145">
						<WrapPanel HorizontalAlignment="Center">

							<Button Content="Ajouter"
                                    Click="BtnNouvelleDiapositive_Click"/>

							<Button Content="Supprimer"
                                    Click="BtnSupprimerDiapositive_Click"/>

						</WrapPanel>

						<TextBlock Text="Diapositives"
                                   Style="{StaticResource GroupTitle}"/>
					</StackPanel>

					<Separator Margin="8,5"/>

					<!-- THÈMES -->
					<StackPanel Width="190">

						<TextBlock Text="Choisir un thème"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="3,5"/>

						<ComboBox x:Name="cmbThemes"
                                  Width="175"
                                  Height="35"
                                  Margin="5"
                                  SelectedIndex="-1"
                                  SelectionChanged="CmbThemes_SelectionChanged"
                                  ToolTip="Appliquer un thème à la présentation">

							<ComboBoxItem Content="Moderne bleu"/>
							<ComboBoxItem Content="Élégant violet"/>
							<ComboBoxItem Content="Sombre"/>
							<ComboBoxItem Content="Minimaliste"/>
							<ComboBoxItem Content="Nature"/>

						</ComboBox>

						<TextBlock Text="Thèmes de présentation"
                                   Style="{StaticResource GroupTitle}"/>

					</StackPanel>

				</StackPanel>
			</ScrollViewer>
		</Border>

		<!-- ZONE DE TRAVAIL -->
		<Grid Grid.Row="3">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="205"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="235"/>
			</Grid.ColumnDefinitions>

			<!-- PANNEAU GAUCHE -->
			<Border Grid.Column="0"
                    Background="#F8F8F8"
                    BorderBrush="#DDDDDD"
                    BorderThickness="0,0,1,0">

				<DockPanel Margin="10">

					<TextBlock Text="Diapositives"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="5,5,5,12"
                               DockPanel.Dock="Top"/>

					<Button Content="+ Nouvelle diapositive"
                            DockPanel.Dock="Bottom"
                            HorizontalAlignment="Stretch"
                            Margin="2,8,2,2"
                            Click="BtnNouvelleDiapositive_Click"/>

					<ListBox x:Name="lstDiapositives"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">

						<ListBox.ItemContainerStyle>
							<Style TargetType="ListBoxItem">
								<Setter Property="HorizontalContentAlignment"
                                        Value="Stretch"/>
								<Setter Property="Padding" Value="3"/>
								<Setter Property="Margin" Value="2,4"/>
							</Style>
						</ListBox.ItemContainerStyle>

						<ListBox.ItemTemplate>
							<DataTemplate>
								<StackPanel Margin="2">

									<Border Background="White"
                                            BorderBrush="#BBBBBB"
                                            BorderThickness="1"
                                            Padding="3"
                                            Width="165"
                                            Height="100">

										<Viewbox Stretch="Uniform">
											<Canvas Width="960"
                                                    Height="540"
                                                    Background="{Binding BackgroundColor, FallbackValue=White}">

												<ItemsControl ItemsSource="{Binding Elements}">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<Canvas/>
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>

													<ItemsControl.ItemContainerStyle>
														<Style TargetType="ContentPresenter">
															<Setter Property="Canvas.Left" Value="{Binding X}"/>
															<Setter Property="Canvas.Top" Value="{Binding Y}"/>
															<Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
														</Style>
													</ItemsControl.ItemContainerStyle>
												</ItemsControl>
											</Canvas>
										</Viewbox>
									</Border>

									<TextBlock Text="{Binding Order, StringFormat=Diapositive {0}}"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Margin="0,4,0,0"
                                               Foreground="#444444"/>
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</DockPanel>
			</Border>

			<!-- CANVAS CENTRAL -->
			<Grid Grid.Column="1" Background="#E8E8E8">

				<ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">

					<Grid>
						<Viewbox Stretch="Uniform"
                                 MaxWidth="960"
                                 MaxHeight="540"
                                 Margin="35">

							<Border Background="White"
                                    Width="960"
                                    Height="540"
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="1">

								<canvas:SlideCanvas x:Name="slideCanvas"/>

							</Border>
						</Viewbox>
					</Grid>
				</ScrollViewer>
			</Grid>

			<!-- PANNEAU DROIT -->
			<Border Grid.Column="2"
                    Background="#FAFAFA"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1,0,0,0">

				<ScrollViewer VerticalScrollBarVisibility="Auto">

					<StackPanel Margin="12">

						<TextBlock Text="Format de l'élément"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,12"/>

						<!-- POSITION -->
						<TextBlock Text="Position"
                                   FontWeight="SemiBold"
                                   Margin="0,5"/>

						<Grid Margin="0,5">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<StackPanel Margin="2">
								<TextBlock Text="Horizontal (X)"/>
								<TextBox x:Name="txtPositionX"
                                         Text="0"
                                         Padding="5"
                                         IsEnabled="False"
                                         TextChanged="Propriete_TextChanged"/>
							</StackPanel>

							<StackPanel Grid.Column="1" Margin="2">
								<TextBlock Text="Vertical (Y)"/>
								<TextBox x:Name="txtPositionY"
                                         Text="0"
                                         Padding="5"
                                         IsEnabled="False"
                                         TextChanged="Propriete_TextChanged"/>
							</StackPanel>
						</Grid>

						<Separator Margin="0,12"/>

						<!-- DIMENSIONS -->
						<TextBlock Text="Dimensions"
                                   FontWeight="SemiBold"
                                   Margin="0,5"/>

						<Grid Margin="0,5">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<StackPanel Margin="2">
								<TextBlock Text="Largeur"/>
								<TextBox x:Name="txtLargeur"
                                         Text="100"
                                         Padding="5"
                                         IsEnabled="False"
                                         TextChanged="Propriete_TextChanged"/>
							</StackPanel>

							<StackPanel Grid.Column="1" Margin="2">
								<TextBlock Text="Hauteur"/>
								<TextBox x:Name="txtHauteur"
                                         Text="50"
                                         Padding="5"
                                         IsEnabled="False"
                                         TextChanged="Propriete_TextChanged"/>
							</StackPanel>
						</Grid>

						<Separator Margin="0,12"/>

						<!-- APPARENCE -->
						<TextBlock Text="Apparence"
                                   FontWeight="SemiBold"
                                   Margin="0,5"/>

						<TextBlock Text="Couleur de remplissage"
                                   Margin="2,8,2,3"/>

						<Button Content="Choisir une couleur"
                                Click="BtnCouleurRemplissage_Click"
                                Padding="5"
                                ToolTip="Modifier la couleur de la forme sélectionnée"/>

						<TextBlock Text="Rotation"
                                   Margin="2,12,2,3"/>

						<Slider x:Name="sliderRotation"
                                Minimum="0"
                                Maximum="360"
                                Value="0"
                                IsEnabled="False"
                                ValueChanged="SliderRotation_ValueChanged"/>

						<TextBlock x:Name="txtValeurRotation"
                                   Text="0°"
                                   HorizontalAlignment="Center"
                                   Margin="2,5"/>

						<!-- LISTE DES CALQUES -->
						<Separator Margin="0,15"/>

						<TextBlock Text="Calques de la diapositive"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,8"/>

						<TextBlock Text="Sélectionnez un élément dans la liste :"
                                   FontSize="11"
                                   Foreground="#777777"
                                   Margin="2,0,2,5"/>

						<ListBox x:Name="lstCalques"
                                 Height="190"
                                 Background="White"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"
                                 SelectionMode="Single"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">

							<ListBox.ItemContainerStyle>
								<Style TargetType="ListBoxItem">
									<Setter Property="Padding" Value="7"/>
									<Setter Property="Margin" Value="2"/>
									<Setter Property="HorizontalContentAlignment"
                                            Value="Stretch"/>
									<Setter Property="Cursor" Value="Hand"/>
								</Style>
							</ListBox.ItemContainerStyle>

							<ListBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Nom}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
								</DataTemplate>
							</ListBox.ItemTemplate>

						</ListBox>

						<TextBlock Text="Utilisez les boutons du ruban pour modifier l'ordre des calques."
                                   TextWrapping="Wrap"
                                   FontSize="10"
                                   Foreground="#888888"
                                   Margin="2,6,2,5"/>

					</StackPanel>
				</ScrollViewer>
			</Border>
		</Grid>

		<!-- BARRE D'ETAT -->
		<Border Grid.Row="4"
                Background="#F8F8F8"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0">

			<Grid Margin="12,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<TextBlock Text="Mini PowerPoint"
                           FontSize="11"
                           Foreground="#666666"
                           VerticalAlignment="Center"/>

				<StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

					<TextBlock Text="Zoom"
                               FontSize="11"
                               VerticalAlignment="Center"/>

					<Slider Width="100"
                            Minimum="50"
                            Maximum="150"
                            Value="100"
                            Margin="10,0"/>

					<TextBlock Text="100%"
                               FontSize="11"
                               VerticalAlignment="Center"/>

				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</Window>
