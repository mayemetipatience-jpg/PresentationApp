<Window x:Class="PresentationApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:canvas="clr-namespace:PresentationApp.UI.Canvas"
        xmlns:models="clr-namespace:PresentationApp.Core.Models;assembly=PresentationApp.Core"
        Title="Mini PowerPoint"
        Height="800"
        Width="1300"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F2">

	<Window.Resources>

		<!-- PALETTE -->
		<SolidColorBrush x:Key="OceanPrimary" Color="#123B46"/>
		<SolidColorBrush x:Key="OceanAccent" Color="#20B5A5"/>
		<SolidColorBrush x:Key="OceanLight" Color="#E5F4F1"/>
		<SolidColorBrush x:Key="OceanBackground" Color="#F3F5F2"/>
		<SolidColorBrush x:Key="OceanBorder" Color="#DCE4E2"/>
		<SolidColorBrush x:Key="OceanText" Color="#123B46"/>
		<SolidColorBrush x:Key="OceanMuted" Color="#668087"/>
		<SolidColorBrush x:Key="OceanCopper" Color="#E8A46B"/>

		<!-- STYLE GENERAL DES BOUTONS -->
		<Style TargetType="{x:Type Button}">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="Foreground" Value="#123B46"/>
			<Setter Property="BorderBrush" Value="#DCE4E2"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="12,7"/>
			<Setter Property="Margin" Value="3"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="MinHeight" Value="30"/>
			<Setter Property="FontSize" Value="12"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#E5F4F1"/>
					<Setter Property="BorderBrush" Value="#20B5A5"/>
				</Trigger>
				<Trigger Property="IsPressed" Value="True">
					<Setter Property="Background" Value="#CDEAE4"/>
				</Trigger>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Opacity" Value="0.5"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<!-- TITRES DES GROUPES -->
		<Style x:Key="GroupTitle" TargetType="{x:Type TextBlock}">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="#668087"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="2,6,2,2"/>
		</Style>

		<!-- GROUPES DU RUBAN -->
		<Style x:Key="RibbonGroup" TargetType="{x:Type GroupBox}">
			<Setter Property="Margin" Value="5,3"/>
			<Setter Property="Padding" Value="8,5"/>
			<Setter Property="BorderBrush" Value="#DCE4E2"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="Foreground" Value="#123B46"/>
			<Setter Property="FontSize" Value="11"/>
		</Style>

		<!-- ONGLETS -->
		<Style TargetType="{x:Type TabItem}">
			<Setter Property="Foreground" Value="#45636A"/>
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="Padding" Value="17,9"/>
			<Setter Property="Margin" Value="2,0"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Style.Triggers>
				<Trigger Property="IsSelected" Value="True">
					<Setter Property="Foreground" Value="#123B46"/>
					<Setter Property="Background" Value="#E5F4F1"/>
					<Setter Property="FontWeight" Value="Bold"/>
				</Trigger>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Foreground" Value="#20B5A5"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<!-- MINIATURE : TEXTE -->
		<DataTemplate DataType="{x:Type models:TextElement}">
			<TextBlock Text="{Binding Text}"
                       Width="{Binding Width}"
                       Height="{Binding Height}"
                       FontFamily="{Binding Style.FontFamily}"
                       FontSize="{Binding Style.FontSize}"
                       Foreground="{Binding Style.TextColor, FallbackValue=Black}"
                       TextWrapping="Wrap"
                       TextAlignment="{Binding Style.TextAlignment, FallbackValue=Left}"
                       ClipToBounds="True"
                       RenderTransformOrigin="0.5,0.5">
				<TextBlock.RenderTransform>
					<RotateTransform Angle="{Binding Rotation}"/>
				</TextBlock.RenderTransform>
				<TextBlock.Style>
					<Style TargetType="{x:Type TextBlock}">
						<Setter Property="FontWeight" Value="Normal"/>
						<Setter Property="FontStyle" Value="Normal"/>
						<Setter Property="TextDecorations" Value="{x:Null}"/>
						<Style.Triggers>
							<DataTrigger Binding="{Binding Style.IsBold}" Value="True">
								<Setter Property="FontWeight" Value="Bold"/>
							</DataTrigger>
							<DataTrigger Binding="{Binding Style.IsItalic}" Value="True">
								<Setter Property="FontStyle" Value="Italic"/>
							</DataTrigger>
							<DataTrigger Binding="{Binding Style.IsUnderline}" Value="True">
								<Setter Property="TextDecorations" Value="Underline"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
		</DataTemplate>

		<!-- MINIATURE : FORMES -->
		<DataTemplate DataType="{x:Type models:ShapeElement}">
			<Grid Width="{Binding Width}" Height="{Binding Height}">
				<Rectangle x:Name="MiniRectangle"
                           Fill="{Binding Style.FillColor}"
                           Stroke="{Binding Style.StrokeColor}"
                           StrokeThickness="{Binding Style.StrokeThickness}"
                           Visibility="Visible"/>
				<Ellipse x:Name="MiniEllipse"
                         Fill="{Binding Style.FillColor}"
                         Stroke="{Binding Style.StrokeColor}"
                         StrokeThickness="{Binding Style.StrokeThickness}"
                         Visibility="Collapsed"/>
				<Line x:Name="MiniLine"
                      X1="0" Y1="0"
                      X2="{Binding Width}"
                      Y2="{Binding Height}"
                      Stroke="{Binding Style.StrokeColor}"
                      StrokeThickness="{Binding Style.StrokeThickness}"
                      Visibility="Collapsed"/>
				<Line x:Name="MiniArrow"
                      X1="0" Y1="0"
                      X2="{Binding Width}"
                      Y2="{Binding Height}"
                      Stroke="{Binding Style.StrokeColor}"
                      StrokeThickness="{Binding Style.StrokeThickness}"
                      Visibility="Collapsed"/>
			</Grid>
			<DataTemplate.Triggers>
				<DataTrigger Binding="{Binding ShapeType}"
                             Value="{x:Static models:ShapeType.Ellipse}">
					<Setter TargetName="MiniRectangle" Property="Visibility" Value="Collapsed"/>
					<Setter TargetName="MiniEllipse" Property="Visibility" Value="Visible"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding ShapeType}"
                             Value="{x:Static models:ShapeType.Line}">
					<Setter TargetName="MiniRectangle" Property="Visibility" Value="Collapsed"/>
					<Setter TargetName="MiniLine" Property="Visibility" Value="Visible"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding ShapeType}"
                             Value="{x:Static models:ShapeType.Arrow}">
					<Setter TargetName="MiniRectangle" Property="Visibility" Value="Collapsed"/>
					<Setter TargetName="MiniArrow" Property="Visibility" Value="Visible"/>
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>

		<!-- MINIATURE : IMAGE -->
		<DataTemplate DataType="{x:Type models:ImageElement}">
			<Border Width="{Binding Width}"
                    Height="{Binding Height}"
                    Background="#E5E5E5"
                    BorderBrush="#999999"
                    BorderThickness="1"
                    RenderTransformOrigin="0.5,0.5">
				<Border.RenderTransform>
					<RotateTransform Angle="{Binding Rotation}"/>
				</Border.RenderTransform>
				<TextBlock Text="Image"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#555555"/>
			</Border>
		</DataTemplate>

		<!-- MINIATURE : TABLEAU -->
		<DataTemplate DataType="{x:Type models:TableElement}">
			<Border Width="{Binding Width}"
                    Height="{Binding Height}"
                    Background="White"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    ClipToBounds="True"
                    RenderTransformOrigin="0.5,0.5">

				<Border.RenderTransform>
					<RotateTransform Angle="{Binding Rotation}"/>
				</Border.RenderTransform>

				<ItemsControl ItemsSource="{Binding Cells}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Vertical"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>

					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<ItemsControl ItemsSource="{Binding}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<UniformGrid Rows="1"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>

								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border BorderBrush="#777777"
                                                BorderThickness="0.5"
                                                Padding="2"
                                                Background="White">
											<TextBlock Text="{Binding}"
                                                       FontSize="8"
                                                       Foreground="Black"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"/>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Border>
		</DataTemplate>

	</Window.Resources>

	<!-- GRILLE PRINCIPALE -->
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="42"/>
			<RowDefinition Height="38"/>
			<RowDefinition Height="175"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="28"/>
		</Grid.RowDefinitions>

		<!-- BARRE SUPERIEURE -->
		<Border Grid.Row="0" Background="#123B46">
			<Grid Margin="12,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Border Width="30" Height="30"
                        Background="#20B5A5"
                        CornerRadius="7"
                        VerticalAlignment="Center"
                        Margin="3,0,12,0">
					<TextBlock Text="P"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
				</Border>

				<TextBlock Grid.Column="1"
                           Text="Mini PowerPoint | Présentation sans titre"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

				<Button Grid.Column="2"
                        Content="Partager"
                        Background="#20B5A5"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"/>
			</Grid>
		</Border>

		<!-- RUBAN ET ONGLETS -->
		<TabControl Grid.Row="1"
                    Grid.RowSpan="2"
                    Background="#FFFFFF"
                    BorderThickness="0"
                    Padding="0">

			<!-- FICHIER -->
			<TabItem Header="Fichier">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="20">
						<TextBlock Text="Gestion de la présentation"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#123B46"
                                   Margin="5,5,5,15"/>
						<WrapPanel>
							<Button Content="Ouvrir"
                                    Width="120"
                                    Height="45"
                                    Click="BoutonFichier_Click"/>
							<TextBlock Text="Accéder aux opérations sur les fichiers."
                                       VerticalAlignment="Center"
                                       Foreground="#668087"
                                       Margin="15,5"/>
						</WrapPanel>
					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<!-- ACCUEIL -->
			<TabItem Header="Accueil" IsSelected="True">
				<ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalContentAlignment="Center">
					<StackPanel Orientation="Horizontal" Margin="5,5">

						<GroupBox Header="Presse-papiers"
                                  Style="{StaticResource RibbonGroup}"
                                  Width="190">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<Button Grid.Column="0"
                                        Content="Coller"
                                        Height="65"
                                        Click="BtnColler_Click"/>
								<StackPanel Grid.Column="1">
									<Button Content="Couper" Click="BtnCouper_Click"/>
									<Button Content="Copier" Click="BtnCopier_Click"/>
								</StackPanel>
							</Grid>
						</GroupBox>

						<GroupBox Header="Mise en forme du texte"
                                  Style="{StaticResource RibbonGroup}"
                                  Width="450">
							<StackPanel>
								<StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
									<ComboBox x:Name="cmbPolice"
                                              Width="145"
                                              Height="30"
                                              Margin="3"
                                              SelectedIndex="0"
                                              SelectionChanged="CmbPolice_SelectionChanged"
                                              ToolTip="Choisir la police">
										<ComboBoxItem Content="Segoe UI"/>
										<ComboBoxItem Content="Arial"/>
										<ComboBoxItem Content="Calibri"/>
										<ComboBoxItem Content="Times New Roman"/>
										<ComboBoxItem Content="Verdana"/>
										<ComboBoxItem Content="Georgia"/>
										<ComboBoxItem Content="Comic Sans MS"/>
									</ComboBox>

									<ComboBox x:Name="cmbTaille"
                                              Width="65"
                                              Height="30"
                                              Margin="3"
                                              SelectedIndex="3"
                                              SelectionChanged="CmbTaille_SelectionChanged"
                                              ToolTip="Taille du texte">
										<ComboBoxItem Content="8"/>
										<ComboBoxItem Content="10"/>
										<ComboBoxItem Content="12"/>
										<ComboBoxItem Content="18"/>
										<ComboBoxItem Content="20"/>
										<ComboBoxItem Content="24"/>
										<ComboBoxItem Content="28"/>
										<ComboBoxItem Content="32"/>
										<ComboBoxItem Content="36"/>
										<ComboBoxItem Content="48"/>
										<ComboBoxItem Content="60"/>
										<ComboBoxItem Content="72"/>
									</ComboBox>

									<ComboBox x:Name="cmbCouleurTexte"
                                              Width="125"
                                              Height="30"
                                              Margin="3"
                                              SelectedIndex="0"
                                              SelectionChanged="CmbCouleurTexte_SelectionChanged"
                                              ToolTip="Couleur du texte">
										<ComboBoxItem Content="Noir" Tag="#000000"/>
										<ComboBoxItem Content="Blanc" Tag="#FFFFFF"/>
										<ComboBoxItem Content="Rouge" Tag="#FF0000"/>
										<ComboBoxItem Content="Vert" Tag="#00FF00"/>
										<ComboBoxItem Content="Bleu" Tag="#0000FF"/>
										<ComboBoxItem Content="Jaune" Tag="#FFFF00"/>
										<ComboBoxItem Content="Orange" Tag="#FFA500"/>
										<ComboBoxItem Content="Violet" Tag="#800080"/>
										<ComboBoxItem Content="Bleu clair" Tag="#ADD8E6"/>
										<ComboBoxItem Content="Rose" Tag="#FFC0CB"/>
										<ComboBoxItem Content="Marron" Tag="#A52A2A"/>
										<ComboBoxItem Content="Gris" Tag="#808080"/>
										<ComboBoxItem Content="Turquoise" Tag="#008080"/>
										<ComboBoxItem Content="Or" Tag="#FFD700"/>
										<ComboBoxItem Content="Vert clair" Tag="#90EE90"/>
										<ComboBoxItem Content="Rose vif" Tag="#FF69B4"/>
									</ComboBox>
								</StackPanel>

								<WrapPanel HorizontalAlignment="Center">
									<Button Content="G"
                                            FontWeight="Bold"
                                            Width="38"
                                            Click="BtnGras_Click"
                                            ToolTip="Mettre en gras"/>
									<Button Content="I"
                                            FontStyle="Italic"
                                            Width="38"
                                            Click="BtnItalique_Click"
                                            ToolTip="Mettre en italique"/>
									<Button Width="38"
                                            Click="BtnSouligne_Click"
                                            ToolTip="Souligner">
										<TextBlock Text="S" TextDecorations="Underline"/>
									</Button>
									<Button Content="≡" FontSize="18" Width="38"
                                            Click="BtnAlignerGauche_Click"
                                            ToolTip="Aligner à gauche"/>
									<Button Content="☰" FontSize="18" Width="38"
                                            Click="BtnCentrerTexte_Click"
                                            ToolTip="Centrer le texte"/>
									<Button Content="≡" FontSize="18" Width="38"
                                            Click="BtnAlignerDroite_Click"
                                            ToolTip="Aligner à droite"/>
								</WrapPanel>
							</StackPanel>
						</GroupBox>

						<GroupBox Header="Diapositives"
                                  Style="{StaticResource RibbonGroup}"
                                  Width="180">
							<StackPanel>
								<Button Content="Ajouter une diapositive"
                                        Height="38"
                                        Click="BtnNouvelleDiapositive_Click"/>
								<Button Content="Supprimer la diapositive"
                                        Height="38"
                                        Click="BtnSupprimerDiapositive_Click"/>
							</StackPanel>
						</GroupBox>

						<GroupBox Header="Modification"
                                  Style="{StaticResource RibbonGroup}"
                                  Width="225">
							<WrapPanel HorizontalAlignment="Center">
								<Button Content="Rotation" Click="BtnRotation_Click"/>
								<Button Content="Supprimer" Click="BtnSupprimerElement_Click"/>
								<Button Content="Remplissage" Click="BtnCouleurRemplissage_Click"/>
								<Button Content="Verrouiller / Déverrouiller"
                                        FontSize="11"
                                        Click="BtnVerrouiller_Click"/>
							</WrapPanel>
						</GroupBox>

						<GroupBox Header="Ordre des calques"
                                  Style="{StaticResource RibbonGroup}"
                                  Width="250">
							<WrapPanel HorizontalAlignment="Center">
								<Button Content="Premier plan" Click="BtnPremierPlan_Click"/>
								<Button Content="Arrière-plan" Click="BtnArrierePlanCalque_Click"/>
								<Button Content="Avancer" Click="BtnAvancerCalque_Click"/>
								<Button Content="Reculer" Click="BtnReculerCalque_Click"/>
							</WrapPanel>
						</GroupBox>

					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<!-- INSERTION -->
			<TabItem Header="Insertion">
				<ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalContentAlignment="Center">
					<StackPanel Orientation="Horizontal" Margin="5,5">

						<GroupBox Header="Texte"
                                  Style="{StaticResource RibbonGroup}"
                                  Width="150">
							<Button Content="Zone de texte"
                                    Height="55"
                                    Background="#E5F4F1"
                                    FontWeight="SemiBold"
                                    Click="BtnTexte_Click"/>
						</GroupBox>

						<GroupBox Header="Formes"
                                  Style="{StaticResource RibbonGroup}"
                                  Width="240">
							<StackPanel>
								<TextBlock Text="Choisir une forme"
                                           Foreground="#668087"
                                           Margin="3,2"/>
								<ComboBox x:Name="cmbFormes"
                                          Width="210"
                                          Height="35"
                                          Margin="3"
                                          IsEditable="False"
                                          SelectedIndex="-1"
                                          SelectionChanged="CmbFormes_SelectionChanged"
                                          ToolTip="Choisir une forme">
									<ComboBoxItem Content="Rectangle" Tag="Rectangle"/>
									<ComboBoxItem Content="Rectangle arrondi" Tag="RoundedRectangle"/>
									<ComboBoxItem Content="Ellipse" Tag="Ellipse"/>
									<ComboBoxItem Content="Losange" Tag="Diamond"/>
									<ComboBoxItem Content="Triangle" Tag="Triangle"/>
									<ComboBoxItem Content="Triangle inversé" Tag="InvertedTriangle"/>
									<ComboBoxItem Content="Pentagone" Tag="Pentagon"/>
									<ComboBoxItem Content="Hexagone" Tag="Hexagon"/>
									<ComboBoxItem Content="Carré" Tag="Square"/>
									<ComboBoxItem Content="Demi-cercle" Tag="SemiCircle"/>
									<ComboBoxItem Content="Croix" Tag="Cross"/>
									<ComboBoxItem Content="Plus" Tag="Plus"/>
									<ComboBoxItem Content="Étoile à 5 branches" Tag="Star5"/>
									<ComboBoxItem Content="Étoile à 6 branches" Tag="Star6"/>
									<ComboBoxItem Content="Flèche droite" Tag="Arrow"/>
									<ComboBoxItem Content="Flèche gauche" Tag="ArrowLeft"/>
									<ComboBoxItem Content="Flèche vers le haut" Tag="ArrowUp"/>
									<ComboBoxItem Content="Flèche vers le bas" Tag="ArrowDown"/>
									<ComboBoxItem Content="Flèche double" Tag="DoubleArrow"/>
									<ComboBoxItem Content="Ligne diagonale" Tag="Line"/>
								</ComboBox>
								<TextBlock Text="20 formes disponibles"
                                           Style="{StaticResource GroupTitle}"/>
							</StackPanel>
						</GroupBox>

						<GroupBox Header="Tableaux"
                                  Style="{StaticResource RibbonGroup}"
                                  Width="270">
							<StackPanel>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<StackPanel Grid.Column="0" Margin="4">
										<TextBlock Text="Nombre de lignes"
                                                   Foreground="#668087"
                                                   Margin="2,2,2,5"/>
										<ComboBox x:Name="cmbLignesTableau"
                                                  Height="32"
                                                  SelectedIndex="2"
                                                  ToolTip="Choisir le nombre de lignes">
											<ComboBoxItem Content="1"/>
											<ComboBoxItem Content="2"/>
											<ComboBoxItem Content="3"/>
											<ComboBoxItem Content="4"/>
											<ComboBoxItem Content="5"/>
											<ComboBoxItem Content="6"/>
											<ComboBoxItem Content="7"/>
											<ComboBoxItem Content="8"/>
											<ComboBoxItem Content="9"/>
											<ComboBoxItem Content="10"/>
											<ComboBoxItem Content="11"/>
											<ComboBoxItem Content="12"/>
											<ComboBoxItem Content="13"/>
											<ComboBoxItem Content="14"/>
											<ComboBoxItem Content="15"/>
											<ComboBoxItem Content="16"/>
											<ComboBoxItem Content="17"/>
											<ComboBoxItem Content="18"/>
											<ComboBoxItem Content="19"/>
											<ComboBoxItem Content="20"/>
										</ComboBox>
									</StackPanel>

									<StackPanel Grid.Column="1" Margin="4">
										<TextBlock Text="Nombre de colonnes"
                                                   Foreground="#668087"
                                                   Margin="2,2,2,5"/>
										<ComboBox x:Name="cmbColonnesTableau"
                                                  Height="32"
                                                  SelectedIndex="2"
                                                  ToolTip="Choisir le nombre de colonnes">
											<ComboBoxItem Content="1"/>
											<ComboBoxItem Content="2"/>
											<ComboBoxItem Content="3"/>
											<ComboBoxItem Content="4"/>
											<ComboBoxItem Content="5"/>
											<ComboBoxItem Content="6"/>
											<ComboBoxItem Content="7"/>
											<ComboBoxItem Content="8"/>
											<ComboBoxItem Content="9"/>
											<ComboBoxItem Content="10"/>
											<ComboBoxItem Content="11"/>
											<ComboBoxItem Content="12"/>
											<ComboBoxItem Content="13"/>
											<ComboBoxItem Content="14"/>
											<ComboBoxItem Content="15"/>
											<ComboBoxItem Content="16"/>
											<ComboBoxItem Content="17"/>
											<ComboBoxItem Content="18"/>
											<ComboBoxItem Content="19"/>
											<ComboBoxItem Content="20"/>
										</ComboBox>
									</StackPanel>
								</Grid>

								<Button Content="Insérer un tableau"
                                        Height="38"
                                        Margin="5,8,5,2"
                                        Background="#20B5A5"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"
                                        Click="BtnInsererTableau_Click"/>
							</StackPanel>
						</GroupBox>

						<!-- NOUVEAU GROUPE : MODIFICATION DU TABLEAU -->
						<GroupBox Header="Modification du tableau"
                                  Style="{StaticResource RibbonGroup}"
                                  Width="260">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0">
									<Button Content="+ Ajouter une ligne"
                                            Click="BtnAjouterLigneTableau_Click"/>
									<Button Content="- Supprimer une ligne"
                                            Click="BtnSupprimerLigneTableau_Click"/>
								</StackPanel>

								<StackPanel Grid.Column="1">
									<Button Content="+ Ajouter une colonne"
                                            Click="BtnAjouterColonneTableau_Click"/>
									<Button Content="- Supprimer une colonne"
                                            Click="BtnSupprimerColonneTableau_Click"/>
								</StackPanel>
							</Grid>
						</GroupBox>

						<GroupBox Header="Images"
                                  Style="{StaticResource RibbonGroup}"
                                  Width="150">
							<Button Content="Insérer une image"
                                    Height="55"
                                    Click="BtnImage_Click"/>
						</GroupBox>

					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<!-- CREATION -->
			<TabItem Header="Création">
				<ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalContentAlignment="Center">
					<StackPanel Orientation="Horizontal" Margin="5,5">
						<GroupBox Header="Thèmes de présentation"
                                  Style="{StaticResource RibbonGroup}"
                                  Width="300">
							<StackPanel>
								<TextBlock Text="Choisir un thème"
                                           Foreground="#668087"
                                           Margin="3,2,3,5"/>
								<ComboBox x:Name="cmbThemes"
                                          Width="250"
                                          Height="38"
                                          Margin="3"
                                          SelectedIndex="-1"
                                          SelectionChanged="CmbThemes_SelectionChanged"
                                          ToolTip="Appliquer un thème à la présentation">
									<ComboBoxItem Content="Moderne bleu"/>
									<ComboBoxItem Content="Élégant violet"/>
									<ComboBoxItem Content="Sombre"/>
									<ComboBoxItem Content="Minimaliste"/>
									<ComboBoxItem Content="Nature"/>
								</ComboBox>
							</StackPanel>
						</GroupBox>

						<GroupBox Header="Arrière-plan"
                                  Style="{StaticResource RibbonGroup}"
                                  Width="190">
							<Button Content="Modifier l'arrière-plan"
                                    Height="55"
                                    Click="BtnArrierePlan_Click"/>
						</GroupBox>
					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<!-- TRANSITIONS -->
			<TabItem Header="Transitions">
				<StackPanel Margin="20">
					<TextBlock Text="Transitions entre les diapositives"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#123B46"
                               Margin="5"/>
					<TextBlock Text="Les commandes de transition seront ajoutées dans cet espace."
                               Foreground="#668087"
                               Margin="5"/>
				</StackPanel>
			</TabItem>

			<!-- ANIMATIONS -->
			<TabItem Header="Animations">
				<StackPanel Margin="20">
					<TextBlock Text="Animations des éléments"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#123B46"
                               Margin="5"/>
					<TextBlock Text="Les commandes d'animation seront ajoutées dans cet espace."
                               Foreground="#668087"
                               Margin="5"/>
				</StackPanel>
			</TabItem>

			<!-- DIAPORAMA -->
			<TabItem Header="Diaporama">
				<StackPanel Margin="20">
					<TextBlock Text="Présentation du diaporama"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#123B46"
                               Margin="5"/>
					<TextBlock Text="Les commandes de lancement du diaporama seront ajoutées dans cet espace."
                               Foreground="#668087"
                               Margin="5"/>
				</StackPanel>
			</TabItem>

			<!-- AFFICHAGE -->
			<TabItem Header="Affichage">
				<StackPanel Margin="20">
					<TextBlock Text="Options d'affichage"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#123B46"
                               Margin="5"/>
					<TextBlock Text="Les commandes d'affichage seront ajoutées dans cet espace."
                               Foreground="#668087"
                               Margin="5"/>
				</StackPanel>
			</TabItem>

		</TabControl>

		<!-- ZONE DE TRAVAIL -->
		<Grid Grid.Row="3">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="205"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="235"/>
			</Grid.ColumnDefinitions>

			<!-- PANNEAU GAUCHE : DIAPOSITIVES -->
			<Border Grid.Column="0"
                    Background="#F3F5F2"
                    BorderBrush="#DCE4E2"
                    BorderThickness="0,0,1,0">
				<DockPanel Margin="10">

					<TextBlock Text="Diapositives"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#123B46"
                               Margin="5,5,5,12"
                               DockPanel.Dock="Top"/>

					<Button Content="+ Nouvelle diapositive"
                            DockPanel.Dock="Bottom"
                            HorizontalAlignment="Stretch"
                            Margin="2,8,2,2"
                            Background="#20B5A5"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="BtnNouvelleDiapositive_Click"/>

					<ListBox x:Name="lstDiapositives"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">

						<ListBox.ItemContainerStyle>
							<Style TargetType="{x:Type ListBoxItem}">
								<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
								<Setter Property="Padding" Value="3"/>
								<Setter Property="Margin" Value="2,4"/>
							</Style>
						</ListBox.ItemContainerStyle>

						<ListBox.ItemTemplate>
							<DataTemplate>
								<StackPanel Margin="2">
									<Border Background="White"
                                            BorderBrush="#CBD8D5"
                                            BorderThickness="1"
                                            Padding="3"
                                            Width="165"
                                            Height="100">

										<Viewbox Stretch="Uniform">
											<Canvas Width="960"
                                                    Height="540"
                                                    Background="{Binding BackgroundColor, FallbackValue=White}">

												<ItemsControl ItemsSource="{Binding Elements}">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<Canvas/>
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>

													<ItemsControl.ItemContainerStyle>
														<Style TargetType="{x:Type ContentPresenter}">
															<Setter Property="Canvas.Left" Value="{Binding X}"/>
															<Setter Property="Canvas.Top" Value="{Binding Y}"/>
															<Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
														</Style>
													</ItemsControl.ItemContainerStyle>
												</ItemsControl>

											</Canvas>
										</Viewbox>
									</Border>

									<TextBlock Text="{Binding Order, StringFormat=Diapositive {0}}"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Margin="0,4,0,0"
                                               Foreground="#45636A"/>
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</DockPanel>
			</Border>

			<!-- CANVAS CENTRAL -->
			<Grid Grid.Column="1" Background="#E9EFEC">
				<ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
					<Grid>
						<Viewbox Stretch="Uniform"
                                 MaxWidth="960"
                                 MaxHeight="540"
                                 Margin="35">
							<Border Background="White"
                                    Width="960"
                                    Height="540"
                                    BorderBrush="#CBD8D5"
                                    BorderThickness="1">
								<canvas:SlideCanvas x:Name="slideCanvas"/>
							</Border>
						</Viewbox>
					</Grid>
				</ScrollViewer>
			</Grid>

			<!-- PANNEAU DROIT : PROPRIETES -->
			<Border Grid.Column="2"
                    Background="#F7F9F7"
                    BorderBrush="#DCE4E2"
                    BorderThickness="1,0,0,0">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="12">

						<TextBlock Text="Format de l'élément"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#123B46"
                                   Margin="0,5,0,12"/>

						<TextBlock Text="Position"
                                   FontWeight="SemiBold"
                                   Foreground="#123B46"
                                   Margin="0,5"/>

						<Grid Margin="0,5">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<StackPanel Margin="2">
								<TextBlock Text="Horizontal (X)" Foreground="#668087"/>
								<TextBox x:Name="txtPositionX"
                                         Text="0"
                                         Padding="5"
                                         IsEnabled="False"
                                         TextChanged="Propriete_TextChanged"/>
							</StackPanel>

							<StackPanel Grid.Column="1" Margin="2">
								<TextBlock Text="Vertical (Y)" Foreground="#668087"/>
								<TextBox x:Name="txtPositionY"
                                         Text="0"
                                         Padding="5"
                                         IsEnabled="False"
                                         TextChanged="Propriete_TextChanged"/>
							</StackPanel>
						</Grid>

						<Separator Margin="0,12" Background="#DCE4E2"/>

						<TextBlock Text="Dimensions"
                                   FontWeight="SemiBold"
                                   Foreground="#123B46"
                                   Margin="0,5"/>

						<Grid Margin="0,5">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<StackPanel Margin="2">
								<TextBlock Text="Largeur" Foreground="#668087"/>
								<TextBox x:Name="txtLargeur"
                                         Text="100"
                                         Padding="5"
                                         IsEnabled="False"
                                         TextChanged="Propriete_TextChanged"/>
							</StackPanel>

							<StackPanel Grid.Column="1" Margin="2">
								<TextBlock Text="Hauteur" Foreground="#668087"/>
								<TextBox x:Name="txtHauteur"
                                         Text="50"
                                         Padding="5"
                                         IsEnabled="False"
                                         TextChanged="Propriete_TextChanged"/>
							</StackPanel>
						</Grid>

						<Separator Margin="0,12" Background="#DCE4E2"/>

						<TextBlock Text="Apparence"
                                   FontWeight="SemiBold"
                                   Foreground="#123B46"
                                   Margin="0,5"/>

						<TextBlock Text="Couleur de remplissage"
                                   Foreground="#668087"
                                   Margin="2,8,2,3"/>

						<Button Content="Choisir une couleur"
                                Click="BtnCouleurRemplissage_Click"
                                Padding="5"
                                ToolTip="Modifier la couleur de la forme sélectionnée"/>

						<TextBlock Text="Rotation"
                                   Foreground="#668087"
                                   Margin="2,12,2,3"/>

						<Slider x:Name="sliderRotation"
                                Minimum="0"
                                Maximum="360"
                                Value="0"
                                IsEnabled="False"
                                ValueChanged="SliderRotation_ValueChanged"/>

						<TextBlock x:Name="txtValeurRotation"
                                   Text="0°"
                                   Foreground="#123B46"
                                   HorizontalAlignment="Center"
                                   Margin="2,5"/>

						<Separator Margin="0,15" Background="#DCE4E2"/>

						<TextBlock Text="Calques de la diapositive"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#123B46"
                                   Margin="0,5,0,8"/>

						<TextBlock Text="Sélectionnez un élément dans la liste :"
                                   FontSize="11"
                                   Foreground="#668087"
                                   Margin="2,0,2,5"/>

						<ListBox x:Name="lstCalques"
                                 Height="190"
                                 Background="White"
                                 BorderBrush="#DCE4E2"
                                 BorderThickness="1"
                                 SelectionMode="Single"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">

							<ListBox.ItemContainerStyle>
								<Style TargetType="{x:Type ListBoxItem}">
									<Setter Property="Padding" Value="7"/>
									<Setter Property="Margin" Value="2"/>
									<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
									<Setter Property="Cursor" Value="Hand"/>
									<Style.Triggers>
										<Trigger Property="IsSelected" Value="True">
											<Setter Property="Background" Value="#E5F4F1"/>
											<Setter Property="Foreground" Value="#123B46"/>
										</Trigger>
									</Style.Triggers>
								</Style>
							</ListBox.ItemContainerStyle>

							<ListBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Nom}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>

						<TextBlock Text="Utilisez les boutons du ruban pour modifier l'ordre des calques."
                                   TextWrapping="Wrap"
                                   FontSize="10"
                                   Foreground="#668087"
                                   Margin="2,6,2,5"/>

					</StackPanel>
				</ScrollViewer>
			</Border>
		</Grid>

		<!-- BARRE D'ETAT -->
		<Border Grid.Row="4"
                Background="#FFFFFF"
                BorderBrush="#DCE4E2"
                BorderThickness="0,1,0,0">
			<Grid Margin="12,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<TextBlock Text="Mini PowerPoint"
                           FontSize="11"
                           Foreground="#668087"
                           VerticalAlignment="Center"/>

				<StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
					<TextBlock Text="Zoom"
                               FontSize="11"
                               Foreground="#45636A"
                               VerticalAlignment="Center"/>
					<Slider Width="100"
                            Minimum="50"
                            Maximum="150"
                            Value="100"
                            Margin="10,0"/>
					<TextBlock Text="100%"
                               FontSize="11"
                               Foreground="#45636A"
                               VerticalAlignment="Center"/>
				</StackPanel>
			</Grid>
		</Border>

	</Grid>
</Window>