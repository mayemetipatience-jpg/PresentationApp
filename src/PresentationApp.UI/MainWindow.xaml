<Window x:Class="PresentationApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:canvas="clr-namespace:PresentationApp.UI.Canvas"
        xmlns:models="clr-namespace:PresentationApp.Core.Models;assembly=PresentationApp.Core"
        Title="Mini PowerPoint"
        Height="800"
        Width="1300"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#D5D5D5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,5,2,0"/>
        </Style>

        <!-- MINIATURE : ELEMENT TEXTE -->
        <DataTemplate DataType="{x:Type models:TextElement}">
            <TextBlock Text="{Binding Text}"
                       Width="{Binding Width}"
                       Height="{Binding Height}"
                       FontFamily="{Binding Style.FontFamily}"
                       FontSize="{Binding Style.FontSize}"
                       Foreground="{Binding Style.TextColor, FallbackValue=Black}"
                       TextWrapping="Wrap"
                       ClipToBounds="True"
                       RenderTransformOrigin="0.5,0.5">

                <TextBlock.RenderTransform>
                    <RotateTransform Angle="{Binding Rotation}"/>
                </TextBlock.RenderTransform>

                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="FontStyle" Value="Normal"/>
                        <Setter Property="TextDecorations" Value="{x:Null}"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Style.IsBold}" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Style.IsItalic}" Value="True">
                                <Setter Property="FontStyle" Value="Italic"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Style.IsUnderline}" Value="True">
                                <Setter Property="TextDecorations" Value="Underline"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>

            </TextBlock>
        </DataTemplate>

        <!-- MINIATURE : ELEMENT FORME -->
        <DataTemplate DataType="{x:Type models:ShapeElement}">
            <Grid Width="{Binding Width}"
          Height="{Binding Height}">

                <!-- Rectangle -->
                <Rectangle x:Name="MiniRectangle"
                   Fill="{Binding Style.FillColor}"
                   Stroke="{Binding Style.StrokeColor}"
                   StrokeThickness="{Binding Style.StrokeThickness}"
                   Visibility="Visible"/>

                <!-- Ellipse -->
                <Ellipse x:Name="MiniEllipse"
                 Fill="{Binding Style.FillColor}"
                 Stroke="{Binding Style.StrokeColor}"
                 StrokeThickness="{Binding Style.StrokeThickness}"
                 Visibility="Collapsed"/>

                <!-- Ligne -->
                <Line x:Name="MiniLine"
              X1="0" Y1="0"
              X2="{Binding Width}"
              Y2="{Binding Height}"
              Stroke="{Binding Style.StrokeColor}"
              StrokeThickness="{Binding Style.StrokeThickness}"
              Visibility="Collapsed"/>

                <!-- Flèche -->
                <Line x:Name="MiniArrow"
              X1="0" Y1="0"
              X2="{Binding Width}"
              Y2="{Binding Height}"
              Stroke="{Binding Style.StrokeColor}"
              StrokeThickness="{Binding Style.StrokeThickness}"
              Visibility="Collapsed"/>
            </Grid>

            <DataTemplate.Triggers>

                <!-- Afficher une ellipse -->
                <DataTrigger Binding="{Binding ShapeType}"
                     Value="{x:Static models:ShapeType.Ellipse}">
                    <Setter TargetName="MiniRectangle"
                    Property="Visibility"
                    Value="Collapsed"/>
                    <Setter TargetName="MiniEllipse"
                    Property="Visibility"
                    Value="Visible"/>
                </DataTrigger>

                <!-- Afficher une ligne -->
                <DataTrigger Binding="{Binding ShapeType}"
                     Value="{x:Static models:ShapeType.Line}">
                    <Setter TargetName="MiniRectangle"
                    Property="Visibility"
                    Value="Collapsed"/>
                    <Setter TargetName="MiniLine"
                    Property="Visibility"
                    Value="Visible"/>
                </DataTrigger>

                <!-- Afficher une flèche -->
                <DataTrigger Binding="{Binding ShapeType}"
                     Value="{x:Static models:ShapeType.Arrow}">
                    <Setter TargetName="MiniRectangle"
                    Property="Visibility"
                    Value="Collapsed"/>
                    <Setter TargetName="MiniArrow"
                    Property="Visibility"
                    Value="Visible"/>
                </DataTrigger>

            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- MINIATURE : ELEMENT IMAGE -->
        <DataTemplate DataType="{x:Type models:ImageElement}">
            <Border Width="{Binding Width}"
                    Height="{Binding Height}"
                    Background="#E5E5E5"
                    BorderBrush="#999999"
                    BorderThickness="1"
                    RenderTransformOrigin="0.5,0.5">

                <Border.RenderTransform>
                    <RotateTransform Angle="{Binding Rotation}"/>
                </Border.RenderTransform>

                <TextBlock Text="Image"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#555555"/>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="38"/>
            <RowDefinition Height="112"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- BARRE SUPERIEURE -->
        <Border Grid.Row="0" Background="#B7472A">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="P"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="5,0,15,0"/>

                <TextBlock Grid.Column="1"
                           Text="Mini PowerPoint | Présentation sans titre"
                           Foreground="White"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Partager"
                            Background="#963820"
                            Foreground="White"
                            BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ONGLETS -->
        <Border Grid.Row="1" Background="White">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource TabButton}" Content="Fichier"/>
                <Button Style="{StaticResource TabButton}"
                        Content="Accueil"
                        FontWeight="Bold"
                        Foreground="#B7472A"/>
                <Button Style="{StaticResource TabButton}" Content="Insertion"/>
                <Button Style="{StaticResource TabButton}" Content="Création"/>
                <Button Style="{StaticResource TabButton}" Content="Transitions"/>
                <Button Style="{StaticResource TabButton}" Content="Animations"/>
                <Button Style="{StaticResource TabButton}" Content="Diaporama"/>
                <Button Style="{StaticResource TabButton}" Content="Affichage"/>
            </StackPanel>
        </Border>

        <!-- RUBAN D'OUTILS -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,1"
                Padding="8,5">

            <StackPanel Orientation="Horizontal">

                <StackPanel Width="125">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="Coller"
                                FontSize="13"
                                Padding="12,18"/>
                        <StackPanel>
                            <Button Content="Couper"/>
                            <Button Content="Copier"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Presse-papiers"
                               Style="{StaticResource GroupTitle}"/>
                </StackPanel>

                <Separator Margin="8,5"/>

                <StackPanel Width="190">
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="Zone de texte"
                                Click="BtnTexte_Click"/>
                        <Button Content="Police"/>
                        <Button Content="Couleur"/>
                        <Button Content="Taille"/>
                    </WrapPanel>
                    <TextBlock Text="Texte"
                               Style="{StaticResource GroupTitle}"/>
                </StackPanel>

                <Separator Margin="8,5"/>

                <!-- FORMES -->
                <StackPanel Width="180">
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="Rectangle"
                                Click="BtnRectangle_Click"/>
                        <Button Content="Ellipse"
                                Click="BtnEllipse_Click"/>
                        <Button Content="Ligne"
                                Click="BtnLigne_Click"/>
                        <Button Content="Flèche"
                                Click="BtnFleche_Click"/>
                    </WrapPanel>
                    <TextBlock Text="Formes"
                               Style="{StaticResource GroupTitle}"/>
                </StackPanel>

                <Separator Margin="8,5"/>

                <!-- MODIFICATION -->
                <StackPanel Width="150">
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="Image"/>
                        <Button Content="Arrière-plan"/>
                        <Button Content="Rotation"/>
                        <Button Content="Supprimer élément"
                                Click="BtnSupprimerElement_Click"/>
                    </WrapPanel>
                    <TextBlock Text="Modification"
                               Style="{StaticResource GroupTitle}"/>
                </StackPanel>

                <Separator Margin="8,5"/>

                <!-- DIAPOSITIVES -->
                <StackPanel Width="145">
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="Ajouter"
                                Click="BtnNouvelleDiapositive_Click"/>
                        <Button Content="Supprimer"/>
                    </WrapPanel>
                    <TextBlock Text="Diapositives"
                               Style="{StaticResource GroupTitle}"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ZONE DE TRAVAIL -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="235"/>
            </Grid.ColumnDefinitions>

            <!-- PANNEAU GAUCHE -->
            <Border Grid.Column="0"
                    Background="#F8F8F8"
                    BorderBrush="#DDDDDD"
                    BorderThickness="0,0,1,0">

                <DockPanel Margin="10">
                    <TextBlock Text="Diapositives"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="5,5,5,12"
                               DockPanel.Dock="Top"/>

                    <Button Content="+ Nouvelle diapositive"
                            DockPanel.Dock="Bottom"
                            HorizontalAlignment="Stretch"
                            Margin="2,8,2,2"
                            Click="BtnNouvelleDiapositive_Click"/>

                    <ListBox x:Name="lstDiapositives"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch"/>
                                <Setter Property="Padding" Value="3"/>
                                <Setter Property="Margin" Value="2,4"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <Border Background="White"
                                            BorderBrush="#BBBBBB"
                                            BorderThickness="1"
                                            Padding="3"
                                            Width="165"
                                            Height="100">

                                        <Viewbox Stretch="Uniform">
                                            <Canvas Width="960"
                                                    Height="540"
                                                    Background="{Binding BackgroundColor, FallbackValue=White}">

                                                <ItemsControl ItemsSource="{Binding Elements}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>

                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left"
                                                                    Value="{Binding X}"/>
                                                            <Setter Property="Canvas.Top"
                                                                    Value="{Binding Y}"/>
                                                            <Setter Property="Panel.ZIndex"
                                                                    Value="{Binding ZIndex}"/>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                </ItemsControl>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>

                                    <TextBlock Text="{Binding Order, StringFormat=Diapositive {0}}"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Margin="0,4,0,0"
                                               Foreground="#444444"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- CANVAS CENTRAL -->
            <Grid Grid.Column="1" Background="#E8E8E8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Viewbox Stretch="Uniform"
                                 MaxWidth="960"
                                 MaxHeight="540"
                                 Margin="35">
                            <Border Background="White"
                                    Width="960"
                                    Height="540"
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="1">
                                <canvas:SlideCanvas x:Name="slideCanvas"/>
                            </Border>
                        </Viewbox>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- PANNEAU DROIT -->
            <Border Grid.Column="2"
                    Background="#FAFAFA"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1,0,0,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <TextBlock Text="Format de l'élément"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,18"/>

                        <TextBlock Text="Position"
                                   FontWeight="SemiBold"
                                   Margin="0,5"/>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="2">
                                <TextBlock Text="Horizontal (X)"/>
                                <TextBox x:Name="txtPositionX"
                                         Text="0"
                                         Padding="5"
                                         IsEnabled="False"
                                         TextChanged="Propriete_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="2">
                                <TextBlock Text="Vertical (Y)"/>
                                <TextBox x:Name="txtPositionY"
                                         Text="0"
                                         Padding="5"
                                         IsEnabled="False"
                                         TextChanged="Propriete_TextChanged"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,12"/>

                        <TextBlock Text="Dimensions"
                                   FontWeight="SemiBold"
                                   Margin="0,5"/>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="2">
                                <TextBlock Text="Largeur"/>
                                <TextBox x:Name="txtLargeur"
                                         Text="100"
                                         Padding="5"
                                         IsEnabled="False"
                                         TextChanged="Propriete_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="2">
                                <TextBlock Text="Hauteur"/>
                                <TextBox x:Name="txtHauteur"
                                         Text="50"
                                         Padding="5"
                                         IsEnabled="False"
                                         TextChanged="Propriete_TextChanged"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,12"/>

                        <TextBlock Text="Apparence"
                                   FontWeight="SemiBold"
                                   Margin="0,5"/>

                        <TextBlock Text="Couleur de remplissage"
                                   Margin="2,8,2,3"/>

                        <Button Content="Choisir une couleur"
                                IsEnabled="False"/>

                        <TextBlock Text="Rotation"
                                   Margin="2,12,2,3"/>

                        <Slider x:Name="sliderRotation"
                                Minimum="0"
                                Maximum="360"
                                Value="0"
                                IsEnabled="False"
                                ValueChanged="SliderRotation_ValueChanged"/>

                        <TextBlock x:Name="txtValeurRotation"
                                   Text="0°"
                                   HorizontalAlignment="Center"
                                   Margin="2,5"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- BARRE D'ETAT -->
        <Border Grid.Row="4"
                Background="#F8F8F8"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0">

            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Mini PowerPoint"
                           FontSize="11"
                           Foreground="#666666"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Zoom"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                    <Slider Width="100"
                            Minimum="50"
                            Maximum="150"
                            Value="100"
                            Margin="10,0"/>
                    <TextBlock Text="100%"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
