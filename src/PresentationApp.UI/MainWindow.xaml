<Window x:Class="PresentationApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:canvas="clr-namespace:PresentationApp.UI.Canvas"
        xmlns:views="clr-namespace:PresentationApp.UI.Views"
        Title="Mini PowerPoint"
        Height="700"
        Width="1300"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F3F3F3">

    <!-- MainWindow ne fait qu'assembler les panneaux :
           - ToolbarView         : le ruban (en haut)
           - SlidePanelView      : les miniatures (à gauche)
           - SlideCanvas         : la diapositive en cours d'édition (au centre, Étudiant 2)
           - PropertiesPanelView : les propriétés de l'élément (à droite) -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- BARRE DE TITRE -->
        <Border Grid.Row="0" Background="#B7472A">
            <StackPanel Orientation="Horizontal" Margin="12,0">
                <TextBlock Text="P" Foreground="White" FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="5,0,15,0"/>
                <TextBlock x:Name="txtTitre" Text="Mini PowerPoint | Présentation sans titre"
                           Foreground="White" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- RUBAN -->
        <views:ToolbarView x:Name="ruban" Grid.Row="1"/>

        <!-- ZONE DE TRAVAIL -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <views:SlidePanelView x:Name="panneauDiapositives" Grid.Column="0"/>

            <!-- Diapositive au centre. En mode « Ajuster », elle prend toute la place disponible. -->
            <ScrollViewer x:Name="zoneDiapositive" Grid.Column="1" Background="#E8E8E8"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled">
                <Viewbox x:Name="vueDiapositive" Stretch="Uniform" Margin="25">
                    <Border Background="White" Width="960" Height="540"
                            BorderBrush="#CCCCCC" BorderThickness="1">
                        <canvas:SlideCanvas x:Name="slideCanvas"/>
                    </Border>
                </Viewbox>
            </ScrollViewer>

            <views:PropertiesPanelView x:Name="panneauProprietes" Grid.Column="2"/>
        </Grid>

        <!-- BARRE D'ÉTAT -->
        <Border Grid.Row="3" Background="#F8F8F8" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0" LastChildFill="False">
                <TextBlock x:Name="txtInfo" DockPanel.Dock="Left" FontSize="11" Foreground="#666666"
                           VerticalAlignment="Center" Text="Diapositive 1 sur 1"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Zoom" FontSize="11" VerticalAlignment="Center"/>
                    <Slider x:Name="sliderZoom" Width="110" Minimum="25" Maximum="200" Value="100"
                            Margin="8,0" VerticalAlignment="Center" IsSnapToTickEnabled="True"
                            TickFrequency="5" ValueChanged="SliderZoom_ValueChanged"/>
                    <TextBlock x:Name="txtZoom" Text="Ajusté" Width="45" FontSize="11"
                               VerticalAlignment="Center"/>
                    <Button Content="Ajuster" FontSize="11" Padding="8,1" Margin="4,2"
                            Click="BtnAjuster_Click" ToolTip="Adapter la diapositive à la fenêtre"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
