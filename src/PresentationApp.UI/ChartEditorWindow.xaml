<Window x:Class="PresentationApp.UI.ChartEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifier le graphique"
        Height="650"
        Width="650"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Text="Modifier le graphique"
                   FontSize="23"
                   FontWeight="Bold"
                   Foreground="#243B53"
                   Margin="0,0,0,15"/>

		<ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
			<StackPanel>
				<TextBlock Text="Type de graphique" FontWeight="SemiBold"/>
				<ComboBox x:Name="cmbType" Height="35" Margin="0,5,0,12">
					<ComboBoxItem Content="Histogramme" Tag="Column"/>
					<ComboBoxItem Content="Barres" Tag="Bar"/>
					<ComboBoxItem Content="Courbe" Tag="Line"/>
					<ComboBoxItem Content="Secteurs" Tag="Pie"/>
					<ComboBoxItem Content="Anneau" Tag="Doughnut"/>
				</ComboBox>

				<TextBlock Text="Titre du graphique" FontWeight="SemiBold"/>
				<TextBox x:Name="txtTitre" Height="35" Margin="0,5,0,12"/>

				<TextBlock Text="Titre de la légende" FontWeight="SemiBold"/>
				<TextBox x:Name="txtLegende" Height="35" Margin="0,5,0,12"/>

				<TextBlock Text="Titre de l'axe horizontal" FontWeight="SemiBold"/>
				<TextBox x:Name="txtAxeHorizontal" Height="35" Margin="0,5,0,12"/>

				<TextBlock Text="Titre de l'axe vertical" FontWeight="SemiBold"/>
				<TextBox x:Name="txtAxeVertical" Height="35" Margin="0,5,0,12"/>

				<TextBlock Text="Catégories (une par ligne)" FontWeight="SemiBold"/>
				<TextBox x:Name="txtCategories"
                         Height="100"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,5,0,12"/>

				<TextBlock Text="Valeurs (une par ligne)" FontWeight="SemiBold"/>
				<TextBox x:Name="txtValeurs"
                         Height="100"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,5,0,12"/>

				<TextBlock Text="Affichage"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,5,0,8"/>

				<CheckBox x:Name="chkLegende"
                          Content="Afficher la légende"
                          Margin="0,4"/>

				<CheckBox x:Name="chkValeurs"
                          Content="Afficher les valeurs"
                          Margin="0,4"/>

				<CheckBox x:Name="chkQuadrillage"
                          Content="Afficher le quadrillage"
                          Margin="0,4"/>
			</StackPanel>
		</ScrollViewer>

		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

			<Button Content="Annuler"
                    Width="110"
                    Height="38"
                    Margin="0,0,10,0"
                    IsCancel="True"/>

			<Button Content="Appliquer"
                    Width="120"
                    Height="38"
                    Background="#2878D0"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnAppliquer_Click"/>
		</StackPanel>
	</Grid>
</Window>
