<UserControl x:Class="PresentationApp.UI.Views.PropertiesPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="fr-FR">

    <!-- Panneau de droite : propriétés de l'élément sélectionné.
         DataContext = PropertiesViewModel.
         Language="fr-FR" : on écrit les nombres décimaux avec une virgule (12,5). -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PresentationApp.UI;component/Resources/RubanStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="VraiVersVisible"/>

            <!-- Champ numérique : validé avec Entrée ou en quittant le champ -->
            <Style x:Key="ChampNombre" TargetType="TextBox">
                <Setter Property="Padding" Value="4,3"/>
                <Setter Property="Margin" Value="2,0,2,4"/>
                <EventSetter Event="KeyDown" Handler="ChampNombre_KeyDown"/>
            </Style>

            <Style x:Key="ListeCouleurs" TargetType="ComboBox">
                <Setter Property="Margin" Value="2,0,2,4"/>
                <Setter Property="SelectedValuePath" Value="Hex"/>
                <Setter Property="ItemTemplate" Value="{StaticResource ModeleCouleur}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">

                <TextBlock Text="Format de l'élément" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Titre}" Foreground="#B7472A" Margin="0,2,0,4"/>

                <TextBlock Text="Cliquez sur un élément de la diapositive pour modifier ses propriétés."
                           Visibility="{Binding AucunElement, Converter={StaticResource VraiVersVisible}}"
                           TextWrapping="Wrap" FontSize="11" Foreground="#888888" Margin="0,6"/>

                <!-- ===== POSITION, TAILLE, ROTATION (tous les éléments) ===== -->
                <StackPanel Visibility="{Binding AElement, Converter={StaticResource VraiVersVisible}}">

                    <TextBlock Text="Position et taille" Style="{StaticResource TitreSection}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Horizontal (X)" Style="{StaticResource Etiquette}"/>
                        <TextBox Grid.Row="1" Style="{StaticResource ChampNombre}"
                                 Text="{Binding X, StringFormat={}{0:0.##}, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Column="1" Text="Vertical (Y)" Style="{StaticResource Etiquette}"/>
                        <TextBox Grid.Column="1" Grid.Row="1" Style="{StaticResource ChampNombre}"
                                 Text="{Binding Y, StringFormat={}{0:0.##}, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Row="2" Text="Largeur" Style="{StaticResource Etiquette}"/>
                        <TextBox Grid.Row="3" Style="{StaticResource ChampNombre}"
                                 Text="{Binding Width, StringFormat={}{0:0.##}, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Grid.Column="1" Grid.Row="2" Text="Hauteur" Style="{StaticResource Etiquette}"/>
                        <TextBox Grid.Column="1" Grid.Row="3" Style="{StaticResource ChampNombre}"
                                 Text="{Binding Height, StringFormat={}{0:0.##}, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                    <TextBlock Text="Appuyez sur Entrée pour valider une valeur."
                               FontSize="10" Foreground="#888888" Margin="2,0,2,0"/>

                    <TextBlock Text="Rotation" Style="{StaticResource TitreSection}"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                                   Text="{Binding Rotation, StringFormat={}{0:0}°}"/>
                        <!-- Delay : une seule action dans l'historique quand on fait glisser le curseur -->
                        <Slider Minimum="0" Maximum="359" SmallChange="1" LargeChange="15"
                                Value="{Binding Rotation, Delay=300}"/>
                    </DockPanel>
                </StackPanel>

                <!-- ===== TEXTE (zones de texte uniquement) ===== -->
                <StackPanel Visibility="{Binding EstTexte, Converter={StaticResource VraiVersVisible}}">

                    <TextBlock Text="Texte" Style="{StaticResource TitreSection}"/>

                    <TextBlock Text="Police" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{Binding Polices}" SelectedItem="{Binding FontFamily}"
                              Margin="2,0,2,4"/>

                    <TextBlock Text="Taille" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{Binding Tailles}" IsEditable="True" Margin="2,0,2,4"
                              Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <ToggleButton Content="G" FontWeight="Bold" ToolTip="Gras"
                                      IsChecked="{Binding IsBold}"/>
                        <ToggleButton Content="I" FontStyle="Italic" ToolTip="Italique"
                                      IsChecked="{Binding IsItalic}"/>
                        <ToggleButton ToolTip="Souligné" IsChecked="{Binding IsUnderline}">
                            <TextBlock Text="S" TextDecorations="Underline"/>
                        </ToggleButton>
                    </StackPanel>

                    <TextBlock Text="Couleur du texte" Style="{StaticResource Etiquette}"/>
                    <ComboBox Style="{StaticResource ListeCouleurs}" ItemsSource="{Binding Couleurs}"
                              SelectedValue="{Binding TextColor}"/>
                </StackPanel>

                <!-- ===== REMPLISSAGE ET CONTOUR (formes uniquement) ===== -->
                <StackPanel Visibility="{Binding EstForme, Converter={StaticResource VraiVersVisible}}">

                    <TextBlock Text="Remplissage et contour" Style="{StaticResource TitreSection}"/>

                    <TextBlock Text="Couleur de remplissage" Style="{StaticResource Etiquette}"/>
                    <ComboBox Style="{StaticResource ListeCouleurs}" ItemsSource="{Binding Couleurs}"
                              SelectedValue="{Binding FillColor}"/>

                    <TextBlock Text="Couleur du contour" Style="{StaticResource Etiquette}"/>
                    <ComboBox Style="{StaticResource ListeCouleurs}" ItemsSource="{Binding Couleurs}"
                              SelectedValue="{Binding StrokeColor}"/>

                    <TextBlock Text="Épaisseur du contour" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{Binding Epaisseurs}" SelectedItem="{Binding StrokeThickness}"
                              Margin="2,0,2,4"/>
                </StackPanel>

                <!-- ===== CALQUES DE LA DIAPOSITIVE ===== -->
                <Separator Margin="0,14,0,0"/>
                <TextBlock Text="Calques de la diapositive" Style="{StaticResource TitreSection}"/>
                <TextBlock Text="Du premier plan (en haut) à l'arrière-plan (en bas)."
                           FontSize="11" Foreground="#777777" Margin="2,0,2,5" TextWrapping="Wrap"/>

                <ListBox ItemsSource="{Binding Calques}"
                         SelectedItem="{Binding CalqueSelectionne}"
                         DisplayMemberPath="Nom"
                         Height="170"
                         Background="White" BorderBrush="#CCCCCC">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
