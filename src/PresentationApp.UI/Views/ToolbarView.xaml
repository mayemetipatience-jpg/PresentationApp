<UserControl x:Class="PresentationApp.UI.Views.ToolbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Ruban en haut de la fenêtre.
         DataContext = PropertiesViewModel : la mise en forme du texte est liée directement.
         Les autres boutons portent un Tag (nom d'une ActionRuban) et sont transmis à MainWindow. -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PresentationApp.UI;component/Resources/RubanStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Un groupe du ruban : contenu en haut, titre gris en bas -->
            <Style x:Key="Groupe" TargetType="DockPanel">
                <Setter Property="LastChildFill" Value="True"/>
                <Setter Property="Margin" Value="4,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <TabControl x:Name="onglets" SelectedIndex="1" Height="128"
                Background="White" BorderBrush="#DDDDDD" Padding="6,4">

        <!-- ================= FICHIER ================= -->
        <TabItem Header="Fichier">
            <StackPanel Orientation="Horizontal">
                <DockPanel Style="{StaticResource Groupe}">
                    <TextBlock DockPanel.Dock="Bottom" Text="Présentation" Style="{StaticResource TitreGroupe}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Nouveau" Tag="Nouveau" Click="Action_Click" ToolTip="Nouvelle présentation (Ctrl+N)"/>
                        <Button Content="Ouvrir..." Tag="Ouvrir" Click="Action_Click" ToolTip="Ouvrir une présentation (Ctrl+O)"/>
                        <Button Content="Enregistrer" Tag="Enregistrer" Click="Action_Click" ToolTip="Enregistrer (Ctrl+S)"/>
                        <Button Content="Enregistrer sous..." Tag="EnregistrerSous" Click="Action_Click" ToolTip="Enregistrer sous (Ctrl+Maj+S)"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </TabItem>

        <!-- ================= ACCUEIL ================= -->
        <TabItem Header="Accueil">
            <StackPanel Orientation="Horizontal">

                <!-- Presse-papiers -->
                <DockPanel Style="{StaticResource Groupe}">
                    <TextBlock DockPanel.Dock="Bottom" Text="Presse-papiers" Style="{StaticResource TitreGroupe}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Coller" Tag="Coller" Click="Action_Click" Padding="12,18" ToolTip="Coller (Ctrl+V)"/>
                        <StackPanel>
                            <Button Content="Couper" Tag="Couper" Click="Action_Click" ToolTip="Couper (Ctrl+X)"/>
                            <Button Content="Copier" Tag="Copier" Click="Action_Click" ToolTip="Copier (Ctrl+C)"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource SeparateurGroupe}"/>

                <!-- Annuler / Refaire -->
                <DockPanel Style="{StaticResource Groupe}">
                    <TextBlock DockPanel.Dock="Bottom" Text="Historique" Style="{StaticResource TitreGroupe}"/>
                    <StackPanel>
                        <Button Content="↶ Annuler" Command="{Binding Main.UndoCommand}" ToolTip="Annuler (Ctrl+Z)"/>
                        <Button Content="↷ Refaire" Command="{Binding Main.RedoCommand}" ToolTip="Refaire (Ctrl+Y)"/>
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource SeparateurGroupe}"/>

                <!-- Diapositives -->
                <DockPanel Style="{StaticResource Groupe}">
                    <TextBlock DockPanel.Dock="Bottom" Text="Diapositives" Style="{StaticResource TitreGroupe}"/>
                    <StackPanel>
                        <Button Content="Nouvelle" Tag="NouvelleDiapositive" Click="Action_Click" ToolTip="Nouvelle diapositive (Ctrl+M)"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Dupliquer" Tag="DupliquerDiapositive" Click="Action_Click"/>
                            <Button Content="Supprimer" Tag="SupprimerDiapositive" Click="Action_Click"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource SeparateurGroupe}"/>

                <!-- Police : liée à PropertiesViewModel, active seulement pour une zone de texte -->
                <DockPanel Style="{StaticResource Groupe}" IsEnabled="{Binding EstTexte}">
                    <TextBlock DockPanel.Dock="Bottom" Text="Police" Style="{StaticResource TitreGroupe}"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="140" Margin="2" ToolTip="Police"
                                      ItemsSource="{Binding Polices}" SelectedItem="{Binding FontFamily}"/>
                            <ComboBox Width="62" Margin="2" IsEditable="True" ToolTip="Taille du texte"
                                      ItemsSource="{Binding Tailles}"
                                      Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
                            <ComboBox Width="120" Margin="2" ToolTip="Couleur du texte"
                                      ItemsSource="{Binding Couleurs}" SelectedValuePath="Hex"
                                      SelectedValue="{Binding TextColor}"
                                      ItemTemplate="{StaticResource ModeleCouleur}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Content="G" FontWeight="Bold" ToolTip="Gras" IsChecked="{Binding IsBold}"/>
                            <ToggleButton Content="I" FontStyle="Italic" ToolTip="Italique" IsChecked="{Binding IsItalic}"/>
                            <ToggleButton ToolTip="Souligné" IsChecked="{Binding IsUnderline}">
                                <TextBlock Text="S" TextDecorations="Underline"/>
                            </ToggleButton>
                            <Border Style="{StaticResource SeparateurGroupe}" Margin="6,4"/>
                            <!-- Icônes de la police Segoe MDL2 Assets, présente sur Windows 10 et 11 -->
                            <Button Style="{StaticResource BoutonIcone}" FontFamily="Segoe MDL2 Assets"
                                    Content="&#xE8E4;" ToolTip="Aligner à gauche"
                                    Command="{Binding AlignerGaucheCommand}"/>
                            <Button Style="{StaticResource BoutonIcone}" FontFamily="Segoe MDL2 Assets"
                                    Content="&#xE8E3;" ToolTip="Centrer"
                                    Command="{Binding AlignerCentreCommand}"/>
                            <Button Style="{StaticResource BoutonIcone}" FontFamily="Segoe MDL2 Assets"
                                    Content="&#xE8E2;" ToolTip="Aligner à droite"
                                    Command="{Binding AlignerDroiteCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource SeparateurGroupe}"/>

                <!-- Modification de l'élément sélectionné -->
                <DockPanel Style="{StaticResource Groupe}">
                    <TextBlock DockPanel.Dock="Bottom" Text="Élément" Style="{StaticResource TitreGroupe}"/>
                    <StackPanel>
                        <Button Content="Pivoter de 90°" Command="{Binding PivoterCommand}"/>
                        <Button Content="Supprimer" Command="{Binding Main.DeleteElementCommand}"
                                ToolTip="Supprimer l'élément (Suppr)"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </TabItem>

        <!-- ================= INSERTION ================= -->
        <TabItem Header="Insertion">
            <StackPanel Orientation="Horizontal">
                <DockPanel Style="{StaticResource Groupe}">
                    <TextBlock DockPanel.Dock="Bottom" Text="Texte et image" Style="{StaticResource TitreGroupe}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Zone de texte" Tag="ZoneTexte" Click="Action_Click"
                                ToolTip="Cliquez ensuite sur la diapositive pour placer le texte"/>
                        <Button Content="Image..." Tag="Image" Click="Action_Click"/>
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource SeparateurGroupe}"/>

                <DockPanel Style="{StaticResource Groupe}">
                    <TextBlock DockPanel.Dock="Bottom" Text="Formes (20)" Style="{StaticResource TitreGroupe}"/>
                    <ComboBox x:Name="cmbFormes" Width="210" Height="32" VerticalAlignment="Center"
                              SelectedIndex="-1" SelectionChanged="CmbFormes_SelectionChanged"
                              ToolTip="Choisir une forme à insérer">
                        <ComboBoxItem Content="Rectangle" Tag="Rectangle"/>
                        <ComboBoxItem Content="Rectangle arrondi" Tag="RoundedRectangle"/>
                        <ComboBoxItem Content="Ellipse" Tag="Ellipse"/>
                        <ComboBoxItem Content="Losange" Tag="Diamond"/>
                        <ComboBoxItem Content="Triangle" Tag="Triangle"/>
                        <ComboBoxItem Content="Triangle inversé" Tag="InvertedTriangle"/>
                        <ComboBoxItem Content="Pentagone" Tag="Pentagon"/>
                        <ComboBoxItem Content="Hexagone" Tag="Hexagon"/>
                        <ComboBoxItem Content="Carré" Tag="Square"/>
                        <ComboBoxItem Content="Demi-cercle" Tag="SemiCircle"/>
                        <ComboBoxItem Content="Croix" Tag="Cross"/>
                        <ComboBoxItem Content="Plus" Tag="Plus"/>
                        <ComboBoxItem Content="Étoile à 5 branches" Tag="Star5"/>
                        <ComboBoxItem Content="Étoile à 6 branches" Tag="Star6"/>
                        <ComboBoxItem Content="Flèche droite" Tag="Arrow"/>
                        <ComboBoxItem Content="Flèche gauche" Tag="ArrowLeft"/>
                        <ComboBoxItem Content="Flèche vers le haut" Tag="ArrowUp"/>
                        <ComboBoxItem Content="Flèche vers le bas" Tag="ArrowDown"/>
                        <ComboBoxItem Content="Flèche double" Tag="DoubleArrow"/>
                        <ComboBoxItem Content="Ligne diagonale" Tag="Line"/>
                    </ComboBox>
                </DockPanel>
            </StackPanel>
        </TabItem>

        <!-- ================= ORGANISER ================= -->
        <TabItem Header="Organiser">
            <StackPanel Orientation="Horizontal">
                <DockPanel Style="{StaticResource Groupe}">
                    <TextBlock DockPanel.Dock="Bottom" Text="Ordre des calques" Style="{StaticResource TitreGroupe}"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Premier plan" Tag="PremierPlan" Click="Action_Click"/>
                            <Button Content="Avancer" Tag="Avancer" Click="Action_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Arrière-plan" Tag="ArrierePlan" Click="Action_Click"/>
                            <Button Content="Reculer" Tag="Reculer" Click="Action_Click"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource SeparateurGroupe}"/>

                <DockPanel Style="{StaticResource Groupe}">
                    <TextBlock DockPanel.Dock="Bottom" Text="Diapositive" Style="{StaticResource TitreGroupe}"/>
                    <Button Content="Changer la couleur de fond" Tag="CouleurFond" Click="Action_Click"
                            VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </TabItem>
    </TabControl>
</UserControl>
