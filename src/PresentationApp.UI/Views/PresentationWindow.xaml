<Window x:Class="PresentationApp.UI.Views.PresentationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:PresentationApp.UI.Canvas"
        Title="Diaporama" WindowStyle="None" WindowState="Maximized"
        ResizeMode="NoResize" Background="Black" Topmost="True"
        KeyDown="OnKeyDown" MouseLeftButtonDown="OnLeftClick"
        MouseRightButtonDown="OnRightClick" MouseMove="OnMouseMove"
        MouseWheel="OnMouseWheel">
    <Grid>
        <!-- Scène : deux calques superposés pour les transitions -->
        <Grid x:Name="Stage" ClipToBounds="True">
            <Viewbox x:Name="BoxA" Stretch="Uniform">
                <cv:SlideCanvas x:Name="LayerA" Width="960" Height="540" IsReadOnly="True"/>
            </Viewbox>
            <Viewbox x:Name="BoxB" Stretch="Uniform" Visibility="Hidden">
                <cv:SlideCanvas x:Name="LayerB" Width="960" Height="540" IsReadOnly="True"/>
            </Viewbox>
        </Grid>

        <!-- Pointeur laser -->
        <Canvas x:Name="LaserLayer" IsHitTestVisible="False">
            <Ellipse x:Name="Laser" Width="18" Height="18" Fill="Red" Opacity="0.85">
                <Ellipse.Effect>
                    <DropShadowEffect Color="Red" BlurRadius="14" ShadowDepth="0"/>
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <!-- Mode présentateur (touche P) -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="360"
                Background="#E6202020" Padding="16"
                Visibility="{Binding IsPresenterVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding ElapsedText}" Foreground="White" FontSize="40" FontWeight="Bold"/>
                <TextBlock Text="{Binding SlideNumberText}" Foreground="#CCCCCC" FontSize="20" Margin="0,4,0,16"/>
                <TextBlock Text="Diapositive suivante" Foreground="#CCCCCC" Margin="0,0,0,6"/>
                <Border Background="Black" BorderBrush="#555" BorderThickness="1" Height="180">
                    <Viewbox Stretch="Uniform">
                        <cv:SlideCanvas x:Name="NextPreview" Width="960" Height="540" IsReadOnly="True"/>
                    </Viewbox>
                </Border>
                <TextBlock Margin="0,24,0,0" Foreground="#888" TextWrapping="Wrap"
                           Text="←/→ naviguer · L laser · P présentateur · Échap quitter"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
